@using Markdig
@model BoothDotDev.Views.MediaLinkModel
@inject MarkdownPipeline MarkdownPipeline

@{
    var hasAlt = !string.IsNullOrWhiteSpace(Model.Alt);
    var hasTitle = !string.IsNullOrEmpty(Model.Title);
}

<figure class="figure text-center @(hasAlt ? "image-with-alt" : "")">
    <div class="figure-img-wrap">
        <video class="figure-img" controls>
            <source src="@Model.Url" type="@Model.MimeType" />
        </video>
        <button type="button" class="expand-badge" aria-label="Expand video" data-lightbox="video">
            <i class="ti ti-maximize"></i>
        </button>
        @if (hasAlt)
        {
            <button type="button" class="alt-badge" aria-expanded="false" aria-label="alt text" data-alt-text="@Model.Alt">alt</button>
        }
    </div>
    @if (hasTitle)
    {
        <figcaption class="figure-caption text-center">@Html.Raw(Markdown.ToHtml(Model.Title!, MarkdownPipeline))</figcaption>
    }
    @if (hasTitle || hasAlt)
    {
        <template data-lightbox-caption-template>
            @if (hasTitle)
            {
                <div class="lightbox-caption-text">@Html.Raw(Markdown.ToHtml(Model.Title!, MarkdownPipeline))</div>
            }
            @if (hasAlt)
            {
                <p class="lightbox-alt-text"><span class="lightbox-alt-label">alt</span> @Model.Alt</p>
            }
        </template>
    }
</figure>
