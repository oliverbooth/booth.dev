@using Markdig
@model BoothDotDev.Views.MediaLinkModel
@inject MarkdownPipeline MarkdownPipeline

@{
    var hasAlt = !string.IsNullOrWhiteSpace(Model.Alt);
    var hasTitle = !string.IsNullOrEmpty(Model.Title);
}

<figure class="figure text-center @(hasAlt ? "image-with-alt" : "")">
    <div class="figure-img-wrap">
        <img src="@Model.Url" alt="@Model.Alt" class="figure-img img-fluid" data-lightbox data-lightbox-src="@Model.Url" />
        @if (hasAlt)
        {
            <button type="button" class="alt-badge" aria-label="Show image description" data-alt-text="@Model.Alt">ALT</button>
        }
    </div>
    @if (hasTitle)
    {
        <figcaption class="figure-caption text-center">@Html.Raw(Markdown.ToHtml(Model.Title!, MarkdownPipeline))</figcaption>
    }
    @if (hasTitle || hasAlt)
    {
        <template data-lightbox-caption-template>
            @if (hasTitle)
            {
                @Html.Raw(Markdown.ToHtml(Model.Title!, MarkdownPipeline))
            }
            @if (hasAlt)
            {
                <p class="lightbox-alt-text"><strong>Alt text:</strong> @Model.Alt</p>
            }
        </template>
    }
</figure>
