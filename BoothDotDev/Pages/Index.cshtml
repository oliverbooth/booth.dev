@page "/"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@model Index
@inject BlogPostService BlogPostService
@inject MarkdownRenderingService MarkdownRenderingService

@{
    string[] statuses =
    [
        "injecting copious amounts of java into my veins",
        "literally screaming at the pain of web dev",
        "seeing sharp",
        "rust? i think you mean CORROSION",
        "help i'm stuck in a website",
        "sudo make me a sandwich (permission denied)",
        "yes, i test in production, how could you tell",
        "it's not a bug, it's an undocumented feature",
        "01101000 01100101 01101100 01110000",
        "418",
        "what even is life anyway",
        "okay but web dev is kinda fun actually",
        "outer wilds is game of the year, every year",
        "test status please ignore"
    ];

    var status = statuses[Random.Shared.Next(statuses.Length)];
}

<div class="page-grid home">

    <section class="home-hero">
        <div class="home-hero-text">
            <span class="eyebrow">hi, i'm -</span>
            <h1>@Strings.MyName</h1>
            <p class="home-tagline">
                Coffee enthusiast with a love for all things tech. Tech enthusiast with a love for all things coffee.
            </p>
            <p class="home-status"><i class="ti ti-terminal-2" aria-hidden="true"></i> @status</p>

            <div class="home-hero-actions">
                <a asp-page="/Portfolio/Index" class="btn btn-primary">see my stuff <i class="ti ti-arrow-right"></i></a>
                <a asp-page="/Blog/Index" class="btn">read a thing</a>
            </div>
        </div>

        <div class="polaroid">
            <img src="~/img/headshot_512x512_2023.jpg" asp-append-version="true" alt="Photo of @Strings.MyName">
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-projects">
        <div class="section-head">
            <h2 id="home-projects">Stuff I've Made</h2>
            <a asp-page="/Portfolio/Index">View all <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="sticky-grid">
            @foreach (var item in Model.Featured)
            {
                <a asp-page="@item.PagePath" asp-all-route-data="@item.RouteValues" class="portfolio-card" data-hue="@item.Hue.ToDataHue()">
                    <div class="portfolio-card-top">
                        <span class="badge">@item.Label</span>
                        @if (item.Status is { } status)
                        {
                            <span class="portfolio-card-status">
                                <span class="dot @(status switch { ProjectStatus.Past => "done", ProjectStatus.Hiatus => "dot-coral", ProjectStatus.Retired => "dot-magenta", _ => "" })"></span>@status.ToString().ToLower()
                            </span>
                        }
                        else if (item.IsWorkInProgress)
                        {
                            <span class="portfolio-card-status">wip</span>
                        }
                    </div>

                    @if (item.WaveformBars.Count > 0)
                    {
                        <div class="portfolio-card-wave" aria-hidden="true">
                            @foreach (var height in item.WaveformBars)
                            {
                                <span style="height:@(height)px"></span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="portfolio-card-media">
                            @if (item.ImageUrl is not null)
                            {
                                <img loading="lazy" src="@item.ImageUrl" alt="@item.Title">
                            }
                        </div>
                    }

                    <h3>@item.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="portfolio-card-desc">@item.Description</p>
                    }
                    @if (item.Tags.Count > 0)
                    {
                        <div class="portfolio-card-tags">
                            @foreach (var tag in item.Tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                    }
                </a>
            }
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-writing">
        <div class="section-head">
            <h2 id="home-writing">Things I've Written</h2>
            <a asp-page="/Blog/Index">View all <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="stack-list">
            @foreach (var post in Model.LatestPosts)
            {
                var category = BlogPostService.GetCategory(post.CategoryId);
                var hue = post.Color ?? category?.EffectiveColor ?? PaletteHue.Brand;

                <a asp-page="/Blog/Article" asp-route-slug="@post.Slug" data-hue="@hue.ToDataHue()">
                    <div class="stack-meta">
                        <div class="post-row-head">
                            @if (category is not null)
                            {
                                <span class="badge">@category.Name</span>
                            }
                            <span class="post-row-title">@post.Title</span>
                        </div>
                        <p class="sub">@Html.Raw(MarkdownRenderingService.RenderPlainTextExcerpt(post, out _))</p>
                    </div>
                    <div class="post-row-meta">
                        <span class="meta-value">@post.PublishedAt.ToShortString()</span>
                        <span class="meta-value">@post.GetEstimatedReadingTime() min read</span>
                    </div>
                </a>
            }
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-activity">
        <div class="section-head">
            <h2 id="home-activity">Latest activity</h2>
            <a asp-page="/Blog/Index"><span class="command-link">git log --all</span> <i class="ti ti-arrow-right"
                                                                                         aria-hidden="true"></i></a>
        </div>

        <div class="stack-list">
            @foreach (var entry in Model.RecentActivity)
            {
                <a asp-page="@entry.PagePath" asp-all-route-data="@entry.RouteValues" data-hue="@entry.Hue.ToDataHue()">
                    <div class="stack-meta">
                        <div class="post-row-head">
                            <span class="badge">@entry.Category</span>
                            @if (entry.Tag is not null)
                            {
                                <span class="tag">@entry.Tag</span>
                            }
                            <span class="post-row-title">@entry.Title</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Excerpt))
                        {
                            <p class="sub">@Html.Raw(entry.Excerpt)</p>
                        }
                    </div>
                    <div class="post-row-meta">
                        <span class="meta-value">@entry.PublishedAt.ToShortString()</span>
                        @if (entry.ReadingMinutes.HasValue)
                        {
                            <span class="meta-value">@entry.ReadingMinutes.ValueOr(0) min read</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-elsewhere">
        <div class="section-head">
            <h2 id="home-elsewhere">Elsewhere</h2>
        </div>

        <partial name="Partials/_Socials" />
    </section>

</div>
