@page "/about"

@{
    ViewData["Title"] = "About";
    ViewData["Page"] = "About";
}

<div class="page">

    <p class="crumb"><a asp-page="/Index">Home</a> / About</p>
    <h1>About me</h1>

    <div class="about-intro">
        <div class="avatar-box">
            <img src="~/img/headshot_512x512_2023.jpg" alt="Profile picture">
        </div>
        <p class="body-copy">
            I'm a developer with a strong background in <span class="emphasis">C#</span>, though I've experimented with plenty of other
            languages along the way.
            Currently studying for a BSc in Computer Science at USW.
            Outside of code, I'm usually playing piano, guitar, or far too many video games.
        </p>
    </div>

    <p class="body-copy">
        My most active projects right now are <a href="https://github.com/oliverbooth/X10D">X10D</a> and
        <a href="https://git.brackeys.dev/bot">the myriad bots</a> which power the official
        <a href="https://discord.gg/brackeys">Brackeys Community</a> discord server.
        I've also written a handful of <a asp-page="/Learn/Index">tutorials</a>, usually covering things I couldn't find written up anywhere
        else.
    </p>

    <h2>Elsewhere</h2>
    <div class="tile-grid">
        <a href="https://github.com/oliverbooth" class="tile">
            <i class="ti ti-brand-github"></i><span class="label">GitHub</span>
        </a>
        <a href="https://bsky.app/profile/booth.dev" class="tile">
            <i class="ti ti-brand-bluesky"></i><span class="label">Bluesky</span>
        </a>
        <a href="https://oliverbooth.itch.io" class="tile">
            <i class="ti ti-device-gamepad-2"></i><span class="label">itch.io</span>
        </a>
        <a href="https://gamejolt.com/@@oliverlukebooth" class="tile">
            <i class="ti ti-bolt"></i><span class="label">GameJolt</span>
        </a>
        <a href="https://linkedin.com/in/oliverlukebooth" class="tile">
            <i class="ti ti-brand-linkedin"></i><span class="label">LinkedIn</span>
        </a>
    </div>

</div>
