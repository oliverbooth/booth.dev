@page "/about"

@{
    ViewData["Title"] = "About";
    ViewData["Page"] = "About";
}

<div class="page about">

    <section class="about-hero">
        <div class="avatar-box">
            <img src="~/img/headshot_512x512_2023.jpg" asp-append-version="true" alt="Photo of @Strings.MyName">
        </div>
        <div>
            <span class="eyebrow">hi, i'm -</span>
            <h1>@Strings.MyName</h1>
        </div>
    </section>

    <section class="about-bio">
        <p>
            I'm a developer with a strong background in <span class="emphasis">C#</span>, though I've experimented with plenty of other
            languages along the way.
            Currently studying for a BSc in Computer Science at USW.
            Outside of code, I'm usually playing piano, guitar, or far too many video games.
        </p>
        <p>
            My most active projects right now are <a href="https://github.com/oliverbooth/X10D">X10D</a> and
            <a href="https://git.brackeys.dev/bot">the myriad bots</a> which power the official
            <a href="https://discord.gg/brackeys">Brackeys Community</a> Discord server.
            I've also written a handful of <a asp-page="/Learn/Tutorials/Index">tutorials</a>, usually covering things I couldn't find
            written up anywhere else.
        </p>
    </section>

    <section class="about-section">
        <h2>find me elsewhere</h2>
        <partial name="Partials/_Socials" />
    </section>

    <section class="about-section">
        <h2>now &amp; also</h2>
        <div class="about-links">
            <a asp-page="/Now" class="pill pill--solid">what i'm up to now</a>
            <a asp-page="/Someday" class="pill">my someday list</a>
            <a asp-page="/Donate" class="pill">buy me a coffee</a>
        </div>
    </section>

</div>
