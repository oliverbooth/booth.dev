@page "/projects"
@using BoothDotDev.Data
@using BoothDotDev.Services
@using Markdig
@inject ProjectService ProjectService
@{
    ViewData["Title"] = "Projects";
    ViewData["Page"] = "Projects";

    var projects = ProjectService.GetProjects()
        .Concat(ProjectService.GetProjects(ProjectStatus.Past))
        .Concat(ProjectService.GetProjects(ProjectStatus.Retired))
        .Concat(ProjectService.GetProjects(ProjectStatus.Hiatus));
}

<div class="page-wide">

    <div class="page-header-row">
        <p class="crumb"><a asp-page="/Index">Home</a> / Projects</p>
        <div class="page-actions">
            <a href="/projects.rss" class="icon-link" aria-label="Subscribe to the projects RSS feed" title="RSS feed"><i
                    class="ti ti-rss"></i></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Admin/Projects/Index" class="btn"><i class="ti ti-edit"></i> Manage</a>
            }
        </div>
    </div>
    <h1>Projects</h1>
    <p class="lede">
        Things I gone done and made. See <a asp-page="/Create/Index">my creation list</a> for my artistic work.
    </p>

    <div class="card-grid">
        @foreach (var project in projects)
        {
            var statusClass = $"{project.Status switch
                {
                    ProjectStatus.Ongoing => "",
                    ProjectStatus.Past => "done",
                    ProjectStatus.Retired => "retired",
                    ProjectStatus.Hiatus => "hiatus",
                    _ => throw new InvalidOperationException($"Unknown project status {project.Status}.")
                }}";

            <a asp-page="/Projects/Project" asp-route-slug="@project.Slug" class="card">
                <div class="card-icon">
                    <img loading="lazy" src="@ProjectService.GetHeroUrl(project)" alt="@project.Name">
                </div>
                <div class="card-body">
                    <p class="title">@project.Name</p>
                    <p class="desc">@Markdown.ToPlainText(project.Description)</p>

                    <span class="status @statusClass">
                        <span class="dot" style="margin-right:5px"></span>
                        @switch (project.Status.ToString())
                        {
                            case "Ongoing":
                                <text>in active development</text>
                                break;

                            case "Past":
                                <text>completed</text>
                                break;

                            case "Retired":
                                <text>retired</text>
                                break;

                            case "Hiatus":
                                <text>on hiatus</text>
                                break;
                        }
                    </span>
                </div>
            </a>
        }
    </div>

</div>
