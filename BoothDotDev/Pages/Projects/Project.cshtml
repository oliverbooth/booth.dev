@page "/project/{slug}"
@using BoothDotDev.Data
@using BoothDotDev.Data.Models
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using Humanizer
@using Markdig
@model Project
@inject MarkdownPipeline MarkdownPipeline
@inject ProjectService ProjectService

@{
    var project = Model.SelectedProject;
    ViewData["Title"] = project.Name;
    ViewData["Post"] = project;
}

<div class="page">

    <div class="page-header-row">
        <p class="crumb"><a asp-page="/Index">Home</a> / <a asp-page="/Projects/Index">Projects</a> / @project.Name</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Admin/Projects/Edit" asp-route-id="@project.Id" class="btn"><i class="ti ti-edit"></i> Edit</a>
        }
    </div>

    @{
        var statusClass = project.Status switch
        {
            ProjectStatus.Past => "done",
            ProjectStatus.Retired => "retired",
            ProjectStatus.Hiatus => "hiatus",
            _ => ""
        };

        var statusText = project.Status switch
        {
            ProjectStatus.Ongoing => "in active development",
            ProjectStatus.Past => "completed",
            ProjectStatus.Retired => "retired",
            ProjectStatus.Hiatus => "on hiatus",
            _ => project.Status.ToString().ToLower()
        };

        var icon = project.RemoteTarget switch
        {
            "GitHub" => "brand-github",
            "GitLab" => "brand-gitlab",
            "Itch.io" => "building-store",
            "PlayStore" => "brand-google-play",
            _ => "world"
        };

        var linkText = project.RemoteTarget switch
        {
            "GitHub" => "Repository",
            "GitLab" => "Repository",
            "Itch.io" => "itch.io Page",
            "PlayStore" => "Google Play Store Page",
            _ => "External site"
        };

        var languages = project.Languages.Where(language => language != "various").ToList();
    }

    <span class="status @statusClass"><span class="dot"></span>@statusText</span>
    <h1 class="project-title">@project.Name</h1>

    <div class="project-desc">
        @Html.Raw(Markdown.ToHtmlUnwrapped(project.Description, MarkdownPipeline))
    </div>

    @if (languages.Count > 0)
    {
        <div class="tag-row">
            @foreach (var language in languages)
            {
                <span class="tag">
                    <img src="~/img/lang/@(language).svg" asp-append-version="true"
                         alt="@ProgrammingLanguage.GetNameFromShorthand(language)">
                    @ProgrammingLanguage.GetNameFromShorthand(language)
                </span>
            }
        </div>
    }

    <div class="action-row">
        <a href="@project.RemoteUrl" class="btn btn-primary"><i class="ti ti-@icon"></i> @linkText</a>
    </div>

    <div class="project-frame">
        <img src="@ProjectService.GetHeroUrl(project)" alt="@project.Name">
    </div>

    <dl class="project-facts">
        <div>
            <dt>started</dt>
            <dd>@project.CreatedAt.ToString("MMM yyyy").ToLower()</dd>
        </div>
        <div>
            <dt>status</dt>
            <dd>@statusText</dd>
        </div>
        @if (languages.Count > 0)
        {
            <div>
                <dt>stack</dt>
                <dd>@string.Join(", ", languages.Select(language => ProgrammingLanguage.GetNameFromShorthand(language)))</dd>
            </div>
        }
    </dl>

    @if (!string.IsNullOrWhiteSpace(project.Details))
    {
        <div class="prose project-details">
            @Html.Raw(ProjectService.GetDetails(project))
        </div>
    }

    @{
        var devlogVisibility = User.Identity?.IsAuthenticated == true ? Visibility.None : Visibility.Published;
        var devlogEntries = ProjectService.GetDevlogs(project, devlogVisibility);
    }

    <section class="project-devlog" aria-labelledby="devlog-heading">
        <div class="section-head">
            <h2 id="devlog-heading">Recent devlogs</h2>
        </div>

        @if (devlogEntries.Count == 0)
        {
            <p class="lede">No devlog entries available.</p>
        }
        else
        {
            <div class="stack-list">
                @foreach (var entry in devlogEntries.Take(3))
                {
                    <a asp-page="/Projects/DevLog" asp-route-projectSlug="@project.Slug" asp-route-slug="@entry.Slug">
                        <div class="stack-meta">
                            <p class="title">@entry.Title</p>
                        </div>
                        <span class="meta-value">@entry.PublishedAt.Humanize()</span>
                    </a>
                }
            </div>
        }
    </section>

</div>
