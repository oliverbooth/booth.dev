@page "/project/{slug}"
@using BoothDotDev.Data
@using BoothDotDev.Data.Models
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using Humanizer
@using Markdig
@model Project
@inject MarkdownPipeline MarkdownPipeline
@inject ProjectService ProjectService

@{
    var project = Model.SelectedProject;
}

<div class="page">

    <p class="crumb"><a asp-page="/Index">Home</a> / <a asp-page="/Projects/Index">Projects</a> / @project.Name</p>

    <div class="card" style="cursor:default">
        <div class="card-icon project-hero-icon">
            <img src="@ProjectService.GetHeroUrl(project)" alt="@project.Name">
        </div>
        <div class="card-body project-body">

            <div class="project-status">
                <span class="dot"></span>
                <span class="status-label">
                    @switch (project.Status)
                    {
                        case ProjectStatus.Ongoing:
                            <text>In Active Development</text>
                            break;
                        case ProjectStatus.Past:
                            <text>Completed</text>
                            break;
                        case ProjectStatus.Retired:
                            <text>Retired</text>
                            break;
                        case ProjectStatus.Hiatus:
                            <text>On Hiatus</text>
                            break;
                    }
                </span>
            </div>

            <h1 class="project-title">@project.Name</h1>

            <div class="project-desc">
                @Html.Raw(Markdown.ToHtmlUnwrapped(project.Description, MarkdownPipeline))
            </div>

            @if (!string.IsNullOrWhiteSpace(project.Details))
            {
                <div class="prose project-details">
                    @Html.Raw(ProjectService.GetDetails(project))
                </div>
            }

            @if (project.Languages is { Count: > 0 } and not ["various"])
            {
                <div class="tag-row">
                    @foreach (var language in project.Languages)
                    {
                        if (language == "various")
                        {
                            continue;
                        }

                        <span class="tag">
                            <img src="~/img/lang/@(language).svg" asp-append-version="true"
                                 alt="@ProgrammingLanguage.GetNameFromShorthand(language)">
                            @ProgrammingLanguage.GetNameFromShorthand(language)
                        </span>
                    }
                </div>
            }

            <div class="action-row">
                @{
                    var icon = project.RemoteTarget switch
                    {
                        "GitHub" => "brand-github",
                        "GitLab" => "brand-gitlab",
                        "Itch.io" => "building-store",
                        "PlayStore" => "brand-google-play",
                        _ => "world"
                    };

                    var linkText = project.RemoteTarget switch
                    {
                        "GitHub" => "Repository",
                        "GitLab" => "Repository",
                        "Itch.io" => "itch.io Page",
                        "PlayStore" => "Google Play Store Page",
                        _ => "External site"
                    };
                }
                <a href="@project.RemoteUrl" class="btn btn-primary"><i class="ti ti-@icon" style="font-size:15px"></i> @linkText</a>
                @*<a href="#" class="btn">Devlog</a>*@
            </div>

            <div class="project-devlog">
                <p class="project-devlog-title">Recent devlog entries</p>
                @{
                    var devlogEntries = ProjectService.GetDevlogs(project);

                    if (devlogEntries.Count == 0)
                    {
                        <p class="lede">No devlog entries available.</p>
                    }
                    else
                    {
                        <div class="project-devlog-list">
                            @foreach (var entry in devlogEntries.Take(2))
                            {
                                <div class="project-devlog-row">
                                    <span><a asp-page="/Projects/DevLog" asp-route-projectSlug="@project.Slug" asp-route-slug="@entry.Slug">@entry.Title</a></span>
                                    <span class="project-devlog-time">@entry.PublishedAt.Humanize()</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

        </div>
    </div>

</div>
