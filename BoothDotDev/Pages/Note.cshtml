@page "/note/{id}"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@inject MarkdownRenderingService MarkdownRenderingService
@model Note

@if (!Model.RetrievedNote.HasValue)
{
    return;
}

@{
    var note = Model.RetrievedNote.ValueOr((Data.Models.Note)null!);
    ViewData["Page"] = "Note";
    ViewData["Post"] = note;
    var published = note.Published;
}

<div class="page">

    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
        <p class="crumb"><a asp-page="/Blog/Index">Write</a> / @note.Title</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Admin/Notes/Edit" asp-route-id="@note.Id" class="btn"><i class="ti ti-edit"></i> Edit</a>
        }
    </div>

    @if (note.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="warning">
            <p class="callout-title"><i class="ti ti-lock"></i> This note is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }

    <span class="eyebrow">Note</span>
    <h1 style="margin:8px 0 12px;font-size:30px">@note.Title</h1>

    <div class="byline">
        <span class="meta">@published.ToShortString()</span>
    </div>

    <div class="prose @note.FontStyle.ToProseClass()" style="margin-top:2.5rem">
        @Html.Raw(MarkdownRenderingService.Render(note, note.Id, note.Published))
    </div>
</div>
