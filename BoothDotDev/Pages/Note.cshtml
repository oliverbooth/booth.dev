@page "/note/{id}"
@inject MarkdownRenderingService MarkdownRenderingService
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Pages.Shared.Partials
@using BoothDotDev.Services
@using DEDrake
@model Note

@if (!Model.RetrievedNote.HasValue)
{
    return;
}

@{
    var note = Model.RetrievedNote.ValueOr((Data.Models.Note)null!);
    ViewData["Page"] = "Note";
    ViewData["Title"] = note.Title;
    ViewData["Post"] = note;
    var published = note.PublishedAt;
}

<div class="page">

    <p class="crumb"><a asp-page="/Blog/Index">Write</a> / @note.Title</p>

    @if (note.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="private">
            <p class="callout-title"><i class="ti ti-lock"></i> This note is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }

    @{
        var header = new ContentHeader
        {
            Title = note.Title,
            Badge = "note",
            BadgeClass = "badge-sun",
            Meta = [$"published {published.ToShortString()}"],
            SourceUrl = $"/note/{(ShortGuid)note.Id}.md",
            EditUrl = User.Identity?.IsAuthenticated == true ? Url.Page("/Admin/Notes/Edit", new { id = note.Id }) : null
        };
    }

    <partial name="Partials/_ContentHeader" model="header" />

    <div class="prose @note.FontStyle.ToProseClass()">
        @Html.Raw(MarkdownRenderingService.Render(note, note.Id, note.PublishedAt))
    </div>
</div>
