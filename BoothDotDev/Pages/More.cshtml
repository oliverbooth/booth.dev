@page "/more"
<div class="page">

    <h1 style="margin:0 0 1.5rem">More</h1>

    <div class="stack-list">
        <a asp-page="/Create">
            <div class="stack-icon"><i class="ti ti-palette" style="font-size:15px"></i></div>
            <div class="stack-meta"><p class="title">Create</p><p class="sub">Music, art, and 3D</p></div>
        </a>
        <a asp-page="/About">
            <div class="stack-icon"><i class="ti ti-user" style="font-size:15px"></i></div>
            <div class="stack-meta"><p class="title">About</p><p class="sub">Who I am</p></div>
        </a>
        <a asp-page="/Donate">
            <div class="stack-icon"><i class="ti ti-heart" style="font-size:15px"></i></div>
            <div class="stack-meta"><p class="title">Donate</p><p class="sub">Support what I make</p></div>
        </a>
    </div>

</div>
