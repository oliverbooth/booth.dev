    <div class="section-head"><h2>Art</h2></div>
    <div class="masonry">
        @for (var index = 0; index < Model.ArtworkItems.Count; index++)
        {
            const CdnMediaResolver.MediaKind mediaKind = CdnMediaResolver.MediaKind.Image;
            var first = index == 0;
            var item = Model.ArtworkItems[index];
            var context = new MarkdownRenderContext(item.Id, item.Published);
            var resolver = new CdnMediaResolver(context, null!, "content");
            var cdnUrl = resolver.ResolveCdnUrl(item.FileName, mediaKind);

            <figure class="masonry-cell @(first ? "tall" : "short")">
                <img src="@cdnUrl"
                     title="@item.Title"
                     alt="@item.FileName"
                     data-lightbox
                     data-lightbox-src="@cdnUrl"/>
                <template data-lightbox-caption-template>
                    @Html.Raw(MarkdownRenderingService.Render(item.Description!, item.Id, item.Published, "content"))
                    <p class="lightbox-caption-date">
                        Made with @item.MadeWith, @item.Published.ToString("MMMM yyyy").
                    </p>
                </template>
            </figure>
        }
    </div>

    <dialog id="lightbox" class="lightbox">
        <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
        <figure>
            <img class="lightbox-image" src="" alt=""/>
            <figcaption class="lightbox-caption"></figcaption>
        </figure>
    </dialog>

</div>
