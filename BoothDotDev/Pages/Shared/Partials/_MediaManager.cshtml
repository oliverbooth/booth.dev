@using BoothDotDev.Data
@model MediaManager

<section class="admin-media media-manager" id="media" data-reorder-scope style="margin-top:2rem">
    <div class="admin-header">
        <div>
            <h2>Media</h2>
            <p>Images, video, and audio. The cover is the image shown on cards, and it is only ever one you choose.</p>
        </div>
    </div>

    @if (Model.Errors is not null)
    {
        <p class="hint form-error">@Model.Errors</p>
    }

    @if (Model.Items.Count == 0)
    {
        <p class="hint">No files yet.</p>
    }
    else
    {
        <form method="post" asp-page="/Admin/Portfolio/Media" asp-page-handler="Reorder" id="media-reorder-form">
            <input type="hidden" name="ownerId" value="@Model.OwnerId">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        </form>

        <ul class="reorder-list" data-reorder-list data-reorder-form="media-reorder-form">
            @foreach (var item in Model.Items)
            {
                <li class="reorder-item media-row" data-reorder-item data-id="@item.Id">
                    <i class="ti ti-grip-vertical reorder-handle" draggable="true" aria-hidden="true"></i>
                    <div class="reorder-move">
                        <button type="button" class="reorder-move-btn" data-move="up" aria-label="Move '@item.FileName' up"><i
                                class="ti ti-chevron-up"></i></button>
                        <button type="button" class="reorder-move-btn" data-move="down" aria-label="Move '@item.FileName' down"><i
                                class="ti ti-chevron-down"></i></button>
                    </div>

                    <div class="media-thumb">
                        @switch (item.Kind)
                        {
                            case MediaKind.Image:
                                <img src="@item.Url" alt="" loading="lazy">
                                break;

                            case MediaKind.Video:
                                <i class="ti ti-video" aria-hidden="true"></i>
                                break;

                            default:
                                <i class="ti ti-music" aria-hidden="true"></i>
                                break;
                        }
                    </div>

                    <div class="media-body">
                        <div class="row-title">
                            @item.FileName
                            @if (item.IsCover)
                            {
                                <span class="badge badge-published">cover</span>
                            }
                        </div>
                        <div class="row-sub">
                            @item.Kind.ToString().ToLowerInvariant()
                            @if (item.Width is { } width && item.Height is { } height)
                            {
                                <text>&middot; @(width)x@(height)</text>
                            }
                            @if (item.Duration is { } duration)
                            {
                                <text>&middot; @duration.ToString(duration.Hours > 0 ? @"h\:mm\:ss" : @"m\:ss")</text>
                            }
                        </div>
                        <form method="post" asp-page="/Admin/Portfolio/Media" asp-page-handler="Alt" class="media-alt">
                            <input type="hidden" name="ownerId" value="@Model.OwnerId">
                            <input type="hidden" name="mediaId" value="@item.Id">
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                            <div class="field">
                                <input type="text" name="alt" value="@item.Alt" maxlength="1000" placeholder="Alt text"
                                       aria-label="Alt text for @item.FileName">
                            </div>
                            <button type="submit" class="icon-btn">save</button>
                        </form>
                    </div>

                    <div class="row-actions">
                        @if (item.IsCover)
                        {
                            <form method="post" asp-page="/Admin/Portfolio/Media" asp-page-handler="ClearCover">
                                <input type="hidden" name="ownerId" value="@Model.OwnerId">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                <button type="submit" class="icon-btn">clear cover</button>
                            </form>
                        }
                        else if (item.Kind == MediaKind.Image)
                        {
                            <form method="post" asp-page="/Admin/Portfolio/Media" asp-page-handler="Cover">
                                <input type="hidden" name="ownerId" value="@Model.OwnerId">
                                <input type="hidden" name="mediaId" value="@item.Id">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                <button type="submit" class="icon-btn">set as cover</button>
                            </form>
                        }
                        <form method="post" asp-page="/Admin/Portfolio/Media" asp-page-handler="Remove"
                              data-confirm="Delete '@item.FileName'? This deletes the file from the CDN and can't be undone.">
                            <input type="hidden" name="ownerId" value="@Model.OwnerId">
                            <input type="hidden" name="mediaId" value="@item.Id">
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                            <button type="submit" class="icon-btn danger">delete</button>
                        </form>
                    </div>
                </li>
            }
        </ul>

        <div class="table-toolbar" data-reorder-save hidden>
            <p class="hint">Order changed - it isn't saved yet.</p>
            <button type="submit" form="media-reorder-form" class="btn btn-primary"><i class="ti ti-device-floppy"></i>Save order</button>
        </div>
    }

    <form method="post" enctype="multipart/form-data" asp-page="/Admin/Portfolio/Media" asp-page-handler="Upload" class="media-upload">
        <input type="hidden" name="ownerId" value="@Model.OwnerId">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        <input type="file" name="files" multiple accept="image/*,video/*,audio/*" required>
        <button type="submit" class="btn btn-primary"><i class="ti ti-upload"></i> Upload</button>
    </form>
</section>
