@model ContentHeader

@if (Model.Badge is not null || Model.Rating is not null || Model.Tags.Count > 0)
{
    <div class="post-tags" data-hue="@Model.Hue">
        @if (Model.Badge is not null)
        {
            <span class="badge @Model.BadgeClass">@Model.Badge</span>
        }
        @if (Model.Rating is not null)
        {
            <span class="tag tag-rating">@Model.Rating</span>
        }
        @foreach (var tag in Model.Tags)
        {
            <a asp-page="/Blog/Index" asp-route-tag="@tag" class="tag">@tag.Replace('-', ' ')</a>
        }
    </div>
}

<h1 class="post-title" data-hue="@Model.Hue">@Model.Title</h1>

<div class="byline">
    @if (Model.AuthorName is { } authorName)
    {
        <div class="avatar" data-initial="@authorName[0]">
            @if (Model.AuthorAvatarUrl is { } avatarUrl)
            {
                <img src="@avatarUrl" alt="" />
            }
        </div>
    }
    <div class="byline-text">
        @if (Model.AuthorName is not null)
        {
            <div class="byline-name">@Model.AuthorName</div>
        }
        <div class="byline-meta">
            @string.Join(" \u00b7 ", Model.Meta)
            @if (Model.Flag is { } flag)
            {
                if (Model.Meta.Count > 0)
                {
                    <text> &middot; </text>
                }

                <span class="meta-flag" data-hue="@flag.Hue"><i class="ti @flag.Icon" aria-hidden="true"></i> @flag.Text</span>
            }
        </div>
    </div>
    <div class="byline-icons">
        @if (Model.ShowVoiceFontToggle)
        {
            <button type="button" class="byline-icon-btn" data-voice-font-toggle aria-pressed="false"
                    title="toggle sans-serif font" aria-label="toggle sans-serif font">
                <span class="byline-icon-sample" aria-hidden="true">Aa</span>
            </button>
        }
        @if (Model.ShowLigatureToggle)
        {
            <button type="button" class="byline-icon-btn" data-ligature-toggle aria-pressed="false"
                    title="toggle ligatures" aria-label="toggle ligatures">
                <span class="byline-icon-ligature-sample" aria-hidden="true">!=</span>
            </button>
        }
        @if (Model.SourceUrl is { } sourceUrl)
        {
            <a href="@sourceUrl" class="byline-icon-btn" title="view source" aria-label="view source">
                <i class="ti ti-code" aria-hidden="true"></i>
            </a>
        }
        @if (Model.EditUrl is { } editUrl)
        {
            <a href="@editUrl" class="byline-icon-btn" title="edit" aria-label="edit">
                <i class="ti ti-pencil" aria-hidden="true"></i>
            </a>
        }
    </div>
</div>
