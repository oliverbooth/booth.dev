@inherits AdminLayout
@{ await InitializeAsync(); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@PageTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.47.0/tabler-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;500&display=swap">
    <link rel="stylesheet" href="~/css/prism.css" asp-append-version="true">
    <link rel="stylesheet" asp-vite="css/style.css" />
    <link rel="stylesheet" asp-vite="css/prism.vs.css" />
    <link rel="stylesheet" asp-vite="css/admin.css" />
</head>

<body>
<div class="admin-shell">

    <nav class="admin-rail">
        <a asp-page="/Admin/Index" class="admin-rail-brand">
            <span class="mark">
                <img src="~/img/OB.svg" asp-append-version="true" alt="@Strings.MyName" title="@Strings.MyName (Alt + H)" accesskey="h"/>
            </span>
            <span>Admin</span>
        </a>

        <div class="admin-nav-group">
            <a asp-page="/Admin/Index" page-match="/Admin/Index" class="admin-nav-item">
                <i class="ti ti-layout-dashboard"></i>Dashboard
            </a>
        </div>

        <div class="admin-nav-group">
            <p class="admin-nav-label">Content</p>
            <a asp-page="/Admin/Posts/Index" page-match="/Admin/Posts" class="admin-nav-item"><i class="ti ti-pencil"></i>Posts</a>
            <a asp-page="/Admin/Notes/Index" page-match="/Admin/Notes" class="admin-nav-item"><i class="ti ti-message-2"></i>Notes</a>
            <a asp-page="/Admin/Tutorials/Index" page-match="/Admin/Tutorials" class="admin-nav-item"><i class="ti ti-school"></i>Tutorials</a>
            <a asp-page="/Admin/Challenges/Index" page-match="/Admin/Challenges" class="admin-nav-item"><i class="ti ti-puzzle"></i>Challenges</a>
            <a asp-page="/Admin/Projects/Index" page-match="/Admin/Projects" class="admin-nav-item"><i class="ti ti-code"></i>Projects</a>
            <a asp-page="/Admin/Creations/Index" page-match="/Admin/Creations" class="admin-nav-item"><i class="ti ti-palette"></i>Creations</a>
            <a asp-page="/Admin/Cdn/Index" page-match="/Admin/Cdn" class="admin-nav-item"><i class="ti ti-database"></i>CDN</a>
            <a asp-page="/Admin/Users/Index" page-match="/Admin/Users" class="admin-nav-item"><i class="ti ti-users"></i>Users</a>
        </div>

        <div class="admin-nav-group">
            <p class="admin-nav-label">Site</p>
            <a asp-page="/Index" class="admin-nav-item"><i class="ti ti-external-link"></i>View site</a>
        </div>

        <div class="admin-rail-footer">
            <div class="admin-user">
                <div class="avatar" data-initial="@CurrentUser.DisplayName[0]"><img src="@CurrentUser.AvatarUrl" alt="@CurrentUser.DisplayName"/></div>
                <div>
                    <p class="name">@CurrentUser.DisplayName</p>
                    <p class="role">Admin</p>
                </div>
            </div>
            <form asp-page="/Admin/Logout" method="post">
                <button type="submit" class="admin-nav-item" style="margin-top:4px">
                    <i class="ti ti-logout"></i>Sign out
                </button>
            </form>
        </div>
    </nav>

    <main class="admin-main">
        @RenderBody()
    </main>

</div>

<vite-hmr-client />
<script src="https://cdn.jsdelivr.net/npm/mathjax@4.1.3/tex-mml-chtml.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mathjs@15.2.0/lib/browser/math.min.js"></script>
<script asp-vite="ts/admin.ts"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
