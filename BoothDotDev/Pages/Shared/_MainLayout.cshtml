@using BoothDotDev.Extensions
@inherits MainLayout
@{ await InitializeAsync(); }
<!DOCTYPE html>
<html lang="en">
<head>
    @await RenderSectionAsync("Head", false)
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta property="og:url" content="@CurrentUrl">
    <meta property="twitter:url" content="@CurrentUrl">
    <meta name="theme-color" content="#6161cd">
    <script>
        // runs before first paint to avoid a flash of the wrong theme; keep in step with resolveTheme() in theme.ts
        (() => {
            let theme = null;
            try {
                theme = localStorage.getItem('theme');
            } catch {
            }

            if (theme !== 'light' && theme !== 'dark') {
                theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }

            document.documentElement.dataset.theme = theme;
        })();

        // runs before first paint to avoid a flash of the serif voice font on pages the reader opted out of;
        // keep in step with voice-font.ts
        (() => {
            let voiceFont = null;
            try {
                voiceFont = localStorage.getItem('voiceFont');
            } catch {
            }

            if (voiceFont === 'sans') {
                document.documentElement.dataset.voiceFont = 'sans';
            }
        })();
    </script>
    <title>@PageTitle</title>

    @Html.Raw(HtmlUtility.CreateMetaTagsForContent(ViewData["Post"], SiteBaseUrl, MarkdownRenderingService, PageTitle, Strings.Tagline))
    @if (Context.Response.StatusCode == StatusCodes.Status200OK)
    {
        <script id="discord:component-embed" type="application/json">@Html.Raw(DiscordEmbedService.Build(ViewData["Post"], SiteBaseUrl, CurrentUrl, ViewData["Title"] as string ?? Strings.MyName, Strings.Tagline))</script>
    }
    <link rel="shortcut icon" href="~/img/favicon.png" asp-append-version="true">
    <link rel="shortcut icon" href="~/img/favicon-dark.png" asp-append-version="true" media="(prefers-color-scheme: light)">
    <link rel="shortcut icon" href="~/img/favicon.png" asp-append-version="true" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.47.0/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/katex.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsxgraph@1.13.1/distrib/jsxgraph.min.css">
    <link rel="stylesheet" href="~/css/prism.css" asp-append-version="true">
    <link rel="stylesheet" asp-vite="css/style.css" />
    <link rel="stylesheet" asp-vite="css/prism.theme.css" />
</head>

<body>
<div class="noise-overlay" aria-hidden="true"></div>
<div class="layout">
    <header class="site-header">
        <nav class="topnav">
            <a asp-page="/Index" class="topnav-brand" title="@Strings.MyName (Alt + H)" accesskey="h">@Strings.MyName</a>
            <div class="topnav-links">
                <a asp-page="/Index" page-match="/Index">Home</a>
                <a asp-page="/Blog/Index" page-match="/Blog,/Note,/Someday">Words</a>
                <a asp-page="/Portfolio/Index" page-match="/Portfolio,/Projects,/Create">Stuff I Made</a>
                <a asp-page="/Learn/Tutorials/Index" asp-route-slug="" page-match="/Learn">Learn</a>
            </div>
            <div class="topnav-secondary">
                <a asp-page="/About" page-match="/About">About</a>
                <a asp-page="/Donate" page-match="/Donate">Donate</a>
                <button type="button" class="icon-link" data-palette-trigger aria-label="Search (Ctrl+K)" title="Search (Ctrl+K)">
                    <i class="ti ti-search"></i>
                </button>
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Dark mode" title="Toggle dark mode">
                    <i class="ti ti-sun" aria-hidden="true"></i>
                    <i class="ti ti-moon" aria-hidden="true"></i>
                </button>
            </div>
        </nav>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        @{
            // the informational version carries the full commit hash after a '+'; show a short one
            var hashIndex = Version.IndexOf('+');
            var shortVersion = hashIndex >= 0 ? Version[..Math.Min(Version.Length, hashIndex + 8)] : Version;
        }
        <p>&copy; @DateTime.Now.Year &middot; Made with <i class="ti ti-heart-filled"></i> by @Strings.MyName &middot; <span
                title="@Version">Version @shortVersion</span></p>
        <ul class="site-footer-links">
            <li><a href="https://git.booth.dev/oliver/booth.dev">Source</a></li>
            <li><a asp-page="/Privacy/Index">Privacy</a></li>
            <li><a asp-page="/Admin/Index">Admin</a></li>
        </ul>
    </footer>
</div>

<dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <figure>
        <img class="lightbox-image" src="" alt="" />
        <div class="lightbox-video-slot" hidden></div>
        <figcaption class="lightbox-caption"></figcaption>
    </figure>
</dialog>

<dialog id="command-palette" class="command-palette">
    <div class="command-palette-input-row">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="text" class="command-palette-input" placeholder="Jump to..." aria-label="Search pages and content"
               autocomplete="off" spellcheck="false" />
        <kbd class="command-palette-esc">Esc</kbd>
    </div>
    <ul class="command-palette-results" role="listbox" aria-label="Search results"></ul>
    <p class="command-palette-empty" hidden>No matches.</p>
</dialog>

<nav class="bottom-nav">
    <a asp-page="/Index" page-match="/Index"><i class="ti ti-home"></i>Home</a>
    <a asp-page="/Blog/Index" page-match="/Blog,/Note,/Someday"><i class="ti ti-pencil"></i>Words</a>
    <a asp-page="/Portfolio/Index" page-match="/Portfolio,/Projects,/Create"><i class="ti ti-hammer"></i>Portfolio</a>
    <a asp-page="/Learn/Tutorials/Index" asp-route-slug="" page-match="/Learn"><i class="ti ti-school"></i>Learn</a>
    <a asp-page="/More" page-match="/More"><i class="ti ti-menu-2"></i>More</a>
    <button type="button" class="theme-toggle" data-theme-toggle>
        <i class="ti ti-sun" aria-hidden="true"></i>
        <i class="ti ti-moon" aria-hidden="true"></i>
        Theme
    </button>
</nav>

<script src="https://cdn.jsdelivr.net/npm/mathjax@4.1.3/tex-mml-chtml.js"></script>
<vite-hmr-client />
<script asp-vite="ts/app.ts"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
