@using BoothDotDev.Data
@model IReadOnlyList<BoothDotDev.Data.MediaItem>

@if (Model.Count > 0)
{
    <section class="media-gallery" aria-label="Media">
        @foreach (var file in Model)
        {
            <figure>
                @switch (file.Kind)
                {
                    case MediaKind.Image:
                        <img src="@file.Url" alt="@(file.Alt ?? "")" loading="lazy" data-lightbox data-lightbox-src="@file.Url">
                        break;

                    case MediaKind.Video:
                        <video controls preload="metadata" src="@file.Url" aria-label="@file.Alt"></video>
                        break;

                    default:
                        <audio controls preload="none" src="@file.Url" aria-label="@(file.Alt ?? file.FileName)"></audio>
                        break;
                }
            </figure>
        }
    </section>
}
