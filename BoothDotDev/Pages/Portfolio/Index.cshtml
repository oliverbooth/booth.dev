@page "/portfolio"
@model Made
@{
    ViewData["Title"] = "Stuff I Made";
    ViewData["Page"] = "Made";
}

<div class="page-grid">

    <div class="page-header-row">
        <span class="eyebrow">
            <a asp-page="/Index"><i class="ti ti-arrow-narrow-left"></i> back home</a>
        </span>

        <div class="page-actions">
            <a href="/projects.rss" class="icon-link" aria-label="Subscribe to the projects RSS feed" title="Projects RSS feed"><i
                    class="ti ti-rss"></i></a>
            <a href="/create.rss" class="icon-link" aria-label="Subscribe to the creations RSS feed" title="Creations RSS feed"><i
                    class="ti ti-rss"></i></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Admin/Projects/Index" class="btn"><i class="ti ti-code"></i> Manage projects</a>
                <a asp-page="/Admin/Creations/Index" class="btn"><i class="ti ti-palette"></i> Manage creations</a>
            }
        </div>
    </div>
    <h1>Stuff I Made</h1>
    <p class="lede">Code, drawings, 3D renders, and music.</p>

    <div data-filter-scope>
        <div class="filter-row">
            <button type="button" class="pill active" aria-pressed="true">All</button>
            <button type="button" class="pill" aria-pressed="false" data-filter="code">Code</button>
            <button type="button" class="pill" aria-pressed="false" data-filter="drawing">Drawing</button>
            <button type="button" class="pill" aria-pressed="false" data-filter="3d">3D</button>
            <button type="button" class="pill" aria-pressed="false" data-filter="music">Music</button>
        </div>

        <div class="sticky-grid">
            @foreach (var item in Model.Items)
            {
                <partial name="Partials/_PortfolioCard" model="item" />
            }
        </div>
    </div>

</div>
