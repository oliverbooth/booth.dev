@page "/portfolio/{projectSlug}/devlog/{slug}"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Pages.Shared.Partials
@using BoothDotDev.Services
@model Devlog
@inject ProjectService ProjectService
@inject MarkdownRenderingService MarkdownRenderingService

@if (Model.SelectedDevlog is not { } devlog)
{
    return;
}

@{
    ViewData["Page"] = "Build";
    ViewData["Post"] = devlog;
    ViewData["Title"] = devlog.Title;
    var published = devlog.PublishedAt;
}

<div class="page">

    <span class="eyebrow">
        <a asp-page="/Portfolio/Item" asp-route-slug="@Model.Project.Slug"><i class="ti ti-arrow-narrow-left"></i> back to @Model.Project.Name</a>
    </span>

    @if (devlog.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="private">
            <p class="callout-title"><i class="ti ti-lock"></i> This devlog entry is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }
    else if (devlog.Visibility == Visibility.Unlisted)
    {
        <div class="callout" data-callout="unlisted">
            <p class="callout-title"><i class="ti ti-eye-off"></i> This devlog entry is unlisted</p>
            <div class="callout-body">
                <p>It doesn't appear in listings or search, but anyone with this link can view it.</p>
            </div>
        </div>
    }

    @{
        var meta = new List<string> { $"published {published.ToShortString()}", $"{devlog.GetEstimatedReadingTime()} min read" };
        if (devlog.UpdatedAt is { } updated)
        {
            meta.Add($"updated {updated.ToShortString()}");
        }
    }

    @{
        var header = new ContentHeader
        {
            Title = devlog.Title,
            Badge = Model.Project.Name,
            BadgeClass = "badge-sky",
            Hue = "sky",
            Meta = meta,
            SourceUrl = $"/project/{Model.Project.Slug}/devlog/{devlog.Slug}.md",
            EditUrl = User.Identity?.IsAuthenticated == true
                ? Url.Page("/Admin/Projects/Devlogs/Edit", new { projectId = Model.Project.Id, id = devlog.Id })
                : null
        };
    }

    <partial name="Partials/_ContentHeader" model="header" />

    <div class="prose">
        @Html.Raw(MarkdownRenderingService.Render(devlog, devlog.Id, devlog.PublishedAt))
    </div>

    @{
        var previousDevlog = ProjectService.GetPreviousDevlog(devlog);
        var nextDevlog = ProjectService.GetNextDevlog(devlog);
    }

    @if (previousDevlog is not null || nextDevlog is not null)
    {
        <div class="post-nav">
            @if (previousDevlog is not null)
            {
                <a asp-page="/Portfolio/Devlog" asp-route-projectSlug="@Model.Project.Slug" asp-route-slug="@previousDevlog.Slug"
                   class="post-nav-link">
                    <span class="post-nav-label"><i class="ti ti-chevron-left"></i> Previous</span>
                    <span class="post-nav-title">@previousDevlog.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty"></div>
            }

            @if (nextDevlog is not null)
            {
                <a asp-page="/Portfolio/Devlog" asp-route-projectSlug="@Model.Project.Slug" asp-route-slug="@nextDevlog.Slug"
                   class="post-nav-link post-nav-link--next">
                    <span class="post-nav-label">Next <i class="ti ti-chevron-right"></i></span>
                    <span class="post-nav-title">@nextDevlog.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty post-nav-empty--next"></div>
            }
        </div>
    }

    <partial name="Partials/_Comments" model="devlog.EnableComments" />

</div>
