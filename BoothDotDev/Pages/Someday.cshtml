@page "/someday"
@inject MarkdownRenderingService MarkdownRenderingService
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@model Someday

@{
    ViewData["Page"] = "Someday";
    ViewData["Title"] = "Someday";
}

<div class="page someday-page">

    <span class="eyebrow">a little bucket list -</span>
    <h1>Someday</h1>

    @if (Model.UpdatedAt is { } updatedAt)
    {
        <p class="page-updated">Updated @updatedAt.ToShortString()</p>
    }

    @if (Model.Entries.Count == 0)
    {
        <p class="body-copy">Nothing here yet.</p>
    }
    else
    {
        string[] badgeStyles = ["badge-brand", "badge-coral", "", "badge-magenta"];

        @for (var index = 0; index < Model.Entries.Count; index++)
        {
            var entry = Model.Entries[index];

            <section class="someday-entry" id="@entry.Slug">
                <span class="badge @badgeStyles[index % badgeStyles.Length]">@((index + 1).ToString("00"))</span>
                <h2>Someday, @entry.Title</h2>
                <div class="prose prose--serif">
                    @Html.Raw(MarkdownRenderingService.Render(entry, entry.Id, entry.PublishedAt))
                </div>
            </section>
        }
    }

    <p class="page-footnote">
        inspired by <a href="https://someday.page">someday.page</a>
    </p>
</div>
