@page "/blog/page/{pageNumber:int}"
@using BoothDotDev.Data
@using BoothDotDev.Services
@model List
@inject BlogPostService BlogPostService

@{
    ViewData["Title"] = "Blog";
    ViewData["Page"] = "Blog";
    var pageCount = BlogPostService.GetPageCount(tags: Model.Tag, visibility: Visibility.Published);
    var previousPage = Model.PageNumber - 1;
    var nextPage = Model.PageNumber + 1;
}

@await Html.PartialAsync("Shared/Partials/_HomeInfoEntry")
@await Html.PartialAsync("Shared/Partials/_BlogEntries", new ViewDataDictionary(ViewData)
{
    ["CurrentPage"] = previousPage // -1 for zero based
})

@{
    <footer class="page-footer">
        <nav class="pagination">
            <a class="previous" asp-page="/Blog/List" asp-route-pageNumber="@previousPage" asp-route-tag="@string.Join('+', Model.Tag)">«&nbsp;Previous&nbsp;@previousPage/@pageCount</a>
            @if (Model.PageNumber < pageCount)
            {
                <a class="next" asp-page="/Blog/List" asp-route-pageNumber="@nextPage" asp-route-tag="@string.Join('+', Model.Tag)">Next&nbsp;@nextPage/@pageCount&nbsp;»</a>
            }
        </nav>
    </footer>}
