@page
@using BoothDotDev.Data
@using BoothDotDev.Services
@model Index
@inject BlogPostService BlogPostService
@inject BlueskyService BlueskyService

@{
    ViewData["Title"] = "Blog";
    ViewData["Page"] = "Blog";

    bool lightTheme = Request.Cookies.TryGetValue("theme", out string? theme) && theme == "light";
}

@await Html.PartialAsync("Shared/Partials/_HomeInfoEntry")
@await Html.PartialAsync("Shared/Partials/_BlogEntries", new ViewDataDictionary(ViewData)
{
    ["CurrentPage"] = 0,
    ["Tags"] = Model.Tag
})

@{
    int pageCount = BlogPostService.GetPageCount(tags: Model.Tag, visibility: Visibility.Published);
    if (pageCount > 1)
    {
        <footer class="page-footer">
            <nav class="pagination">
                <a class="next" asp-page="/Blog/List" asp-route-pageNumber="2" asp-route-tag="@string.Join('+', Model.Tag)">Next&nbsp;2/@pageCount&nbsp;»</a>
            </nav>
        </footer>
    }
}

<div style="padding-top: 150px">
    @{
        BlueskyPost? latestPost = await BlueskyService.GetLatestPostAsync();
        @if (latestPost is not null)
        {
            <blockquote class="bluesky-embed" data-bluesky-uri="at://@latestPost.AtUri" data-bluesky-lang="" data-bluesky-embed-color-mode="@(lightTheme ? "light" : "dark")">
                <a href="@latestPost.PostUrl">View on Bluesky</a>
            </blockquote>
            <script async src="https://embed.bsky.app/static/embed.js" charset="utf-8"></script>
        }
    }
</div>