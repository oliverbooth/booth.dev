@page "/blog"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using DEDrake
@model Index
@inject BlogPostService BlogPostService
@inject MarkdownRenderingService MarkdownRenderingService

<div class="page">

    <p class="crumb"><a asp-page="/Index">Home</a> / Write</p>
    <div class="page-header-row">
        <h1>words</h1>
        <div class="page-actions">
            <a asp-page="/Blog/Stats" class="icon-link" aria-label="View blog stats" title="Blog stats"><i class="ti ti-chart-bar"></i></a>
            <a href="/blog.rss" class="icon-link" aria-label="Subscribe to the blog RSS feed" title="Blog RSS feed"><i
                    class="ti ti-rss"></i></a>
            <a href="/notes.rss" class="icon-link" aria-label="Subscribe to the notes RSS feed" title="Notes RSS feed"><i
                    class="ti ti-notes"></i></a>
        </div>
    </div>
    @if (Model.Tag is { } tag)
    {
        <p class="lede">
            Showing posts tagged &ldquo;@tag.Replace('-', ' ')&rdquo; &middot; <a asp-page="/Blog/Index">Clear filter</a>
        </p>
    }
    else
    {
        <p class="lede">look mom, i know how to english gooder. are you proud of me?</p>
    }

    <div data-filter-scope>
        <div class="filter-row">
            <button type="button" class="pill active" aria-pressed="true" data-hue="brand">All</button>
            @foreach (var category in Model.BlogPostCategories)
            {
                <button type="button" class="pill" aria-pressed="false" data-filter="@category.Id" data-hue="@category.EffectiveColor.ToDataHue()">@category.Name</button>
            }
            <button type="button" class="pill" aria-pressed="false" data-filter-kind="note" data-hue="sun">Notes</button>
            <a class="pill" asp-page="/Someday">Someday</a>
        </div>

        <div class="post-list">
            @foreach (var post in Model.BlogPosts)
            {
                var rootCategoryResult = BlogPostService.GetParentCategory(post);
                var rootCategory = rootCategoryResult.IsSuccess ? rootCategoryResult.Value : null;
                var displayCategory = BlogPostService.GetCategory(post.CategoryId) ?? rootCategory;
                var postHue = post.Color ?? displayCategory?.EffectiveColor ?? PaletteHue.Brand;

                <a asp-page="/Blog/Article" asp-route-slug="@post.Slug" class="post-row" data-hue="@postHue.ToDataHue()" data-state="@rootCategory?.Id">
                    <div class="collapse-inner">
                        <div class="post-row-body">
                            <div class="post-row-text">
                                <div class="post-row-head">
                                    @if (displayCategory is not null)
                                    {
                                        <span class="badge @postHue.ToBadgeClass()">@displayCategory.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-brand">post</span>
                                    }
                                    <span class="post-row-title">@post.Title</span>
                                </div>
                                <span class="post-row-sub">@MarkdownRenderingService.RenderPlainTextExcerpt(post, out _)</span>
                            </div>
                            <div class="post-row-meta">
                                <span class="meta-value">@post.PublishedAt.ToShortString()</span>
                                <span class="meta-value">@post.GetEstimatedReadingTime() min read</span>
                            </div>
                        </div>
                    </div>
                </a>
            }

            @foreach (var note in Model.Notes)
            {
                <a asp-page="/Note" asp-route-id="@((ShortGuid)note.Id)" class="post-row" data-hue="sun" data-kind="note" data-state="note">
                    <div class="collapse-inner">
                        <div class="post-row-body">
                            <div class="post-row-text">
                                <div class="post-row-head">
                                    <span class="badge badge-sun">note</span>
                                    <span class="post-row-title">@note.Title</span>
                                </div>
                                <span class="post-row-sub">@MarkdownRenderingService.RenderPlainTextPreview(note.Content, 160)</span>
                            </div>
                            <div class="post-row-meta">
                                <span class="meta-value">@note.PublishedAt.ToShortString()</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>

</div>
