@page
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using DEDrake
@model Index
@inject BlogPostService BlogPostService

<div class="page">

    <p class="crumb"><a asp-page="/Index">Home</a> / Write</p>
    <h1>Write</h1>
    <p class="lede">I write for me, not for you. Unless it's tech-related. Then I write for you. But also me.</p>

    <div data-filter-scope>
        <div class="filter-row">
            <span class="pill active">All</span>
            @foreach (var category in Model.BlogPostCategories)
            {
                <span class="pill" data-filter="@category.Id">@category.Name</span>
            }
            <span class="pill" data-filter-kind="note">Notes</span>
        </div>

        <div class="commit-log" style="margin-bottom:3rem">
            @for (var index = 0; index < Model.BlogPosts.Count; index++)
            {
                var post = Model.BlogPosts[index];
                var first = index == 0;
                var categoryResult = BlogPostService.GetParentCategory(post);
                var category = categoryResult.IsSuccess ? categoryResult.Value : null;

                <a asp-page="/Blog/Article" asp-route-slug="@post.Slug"
                   class="commit"
                   data-state="@category?.Id">
                    <div class="collapse-inner">
                        <div class="commit-dot@(first ? "" : " muted")"></div>
                        <div class="commit-meta">
                            <span class="commit-hash">@post.Id.ToString()[..7]</span><span class="commit-tag">blog</span>
                        </div>
                        <p class="commit-title">@post.Title</p>
                        <p class="commit-sub">@post.GetEstimatedReadingTime() min read &middot; @post.Published.ToShortString()</p>
                    </div>
                </a>
            }

            @for (var index = 0; index < Model.Notes.Count; index++)
            {
                var note = Model.Notes[index];
                var first = index == 0;
                var id = (ShortGuid)note.Id;

                <a href="@id.ToRoute("note")" class="commit" data-kind="note" data-state="note">
                    <div class="collapse-inner">
                        <div class="commit-dot@(first ? "" : " muted")"></div>
                        <div class="commit-meta">
                            <span class="commit-hash">@note.Id.ToString()[..7]</span><span class="commit-tag">note</span>
                        </div>
                        <p class="commit-title">@note.Title</p>
                        <p class="commit-sub">@note.Published.ToShortString()</p>
                    </div>
                </a>
            }
        </div>
    </div>

</div>
