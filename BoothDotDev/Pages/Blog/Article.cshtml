@page "/blog/{slug}"
@inject BlogPostService BlogPostService
@inject CommentService CommentService
@inject MarkdownRenderingService MarkdownRenderingService
@using BoothDotDev.Data
@using BoothDotDev.Data.Models
@using BoothDotDev.Extensions
@using BoothDotDev.Pages.Shared.Partials
@using BoothDotDev.Services
@using Humanizer
@model Article

@if (Model.Post is not { } post)
{
    return;
}

@{
    ViewData["Page"] = "Blog";
    ViewData["Post"] = post;
    ViewData["Title"] = post.Title;
    var author = post.Author;
    var published = post.PublishedAt;
    var category = BlogPostService.GetCategory(post.CategoryId)!;
}

<div class="page">

    <p class="crumb"><a asp-page="/Blog/Index">Write</a> / @post.Title</p>

    @if (post.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="private">
            <p class="callout-title"><i class="ti ti-lock"></i> This post is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }
    else if (post.Visibility == Visibility.Unlisted)
    {
        <div class="callout" data-callout="unlisted">
            <p class="callout-title"><i class="ti ti-eye-off"></i> This post is unlisted</p>
            <div class="callout-body">
                <p>It doesn't appear in listings or search, but anyone with this link can view it.</p>
            </div>
        </div>
    }

    @{
        var header = new ContentHeader
        {
            Title = post.Title,
            Badge = category.Name,
            BadgeClass = category.EffectiveColor.ToBadgeClass(),
            Hue = category.EffectiveColor.ToDataHue(),
            Tags = post.Tags,
            AuthorName = author.DisplayName,
            AuthorAvatarUrl = author.AvatarUrl,
            Meta = [$"published {published.ToShortString()}", $"{post.GetEstimatedReadingTime()} min read"],
            SourceUrl = $"/blog/{post.Slug}.md",
            EditUrl = User.Identity?.IsAuthenticated == true ? Url.Page("/Admin/Posts/Edit", new { id = post.Id }) : null
        };
    }

    <partial name="Partials/_ContentHeader" model="header" />

    @if (post.ShowTableOfContents)
    {
        <details class="callout" data-callout="note" style="margin-top:1.5rem" open="@(post.TableOfContentsExpanded ? "open" : null)">
            <summary class="callout-title"><i class="ti ti-list"></i> Table of Contents</summary>
            <div class="callout-body">
                @Html.Raw(MarkdownRenderingService.RenderTableOfContents(post.Body, Request))
            </div>
        </details>
    }

    <div class="prose @category.FontStyle.ToProseClass()">
        @Html.Raw(MarkdownRenderingService.Render(post, post.Id, post.PublishedAt))
    </div>

    @{
        var previousPost = BlogPostService.GetPreviousPost(post);
        var nextPost = BlogPostService.GetNextPost(post);
    }

    @if (previousPost is not null || nextPost is not null)
    {
        <div class="post-nav">
            @if (previousPost is not null)
            {
                var previousCategory = BlogPostService.GetCategory(previousPost.CategoryId)!;
                <a asp-page="/Blog/Article" asp-route-slug="@previousPost.Slug" class="post-nav-link" data-hue="@previousCategory.EffectiveColor.ToDataHue()">
                    <span class="post-nav-label"><i class="ti ti-chevron-left"></i> Previous</span>
                    <span class="post-nav-title">@previousPost.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty"></div>
            }

            @if (nextPost is not null)
            {
                var nextCategory = BlogPostService.GetCategory(nextPost.CategoryId)!;
                <a asp-page="/Blog/Article" asp-route-slug="@nextPost.Slug" class="post-nav-link post-nav-link--next" data-hue="@nextCategory.EffectiveColor.ToDataHue()">
                    <span class="post-nav-label">Next <i class="ti ti-chevron-right"></i></span>
                    <span class="post-nav-title">@nextPost.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty post-nav-empty--next"></div>
            }
        </div>
    }

    <partial name="Partials/_Comments" model="post.EnableComments" />

    @{
        var commentCount = CommentService.GetLegacyCommentCount(post);
        if (commentCount > 0)
        {
            <div class="legacy-comments-heading">
                <h2 style="margin:0">@("legacy comment".ToQuantity(commentCount))</h2>
                <p class="legacy-comments-subtitle">
                    Legacy comments were posted using a commenting system I no longer use. They exist here for posterity.
                </p>
            </div>

            var nestLevelMap = new Dictionary<LegacyComment, int>();
            var legacyComments = CommentService.GetLegacyComments(post);
            var comments = legacyComments.OrderByDescending(c => c.CreatedAt);
            var commentStack = new Stack<LegacyComment>(comments);

            <div class="legacy-comment-thread">
                @while (commentStack.Count > 0)
                {
                    var comment = commentStack.Pop();
                    var replies = CommentService.GetLegacyReplies(comment);
                    foreach (var reply in replies.OrderByDescending(c => c.CreatedAt))
                    {
                        if (nestLevelMap.TryGetValue(comment, out var currentLevel))
                        {
                            nestLevelMap[reply] = currentLevel + 1;
                        }
                        else
                        {
                            nestLevelMap[reply] = 1;
                        }

                        commentStack.Push(reply);
                    }

                    var isNested = nestLevelMap.ContainsKey(comment);
                    var avatarUrl = comment.GetAvatarUrl();

                    <div class="legacy-comment@(isNested ? " legacy-comment--nested" : "")">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img class="legacy-comment-avatar" src="@avatarUrl" alt="@comment.Author">
                        }
                        else
                        {
                            <div class="legacy-comment-avatar-fallback">@comment.Author[0]</div>
                        }
                        <div class="legacy-comment-body">
                            <div class="legacy-comment-header">
                                <span class="legacy-comment-author">@comment.Author</span>
                                <abbr class="legacy-comment-time"
                                      title="@comment.CreatedAt.ToString("dddd, d MMMM yyyy HH:mm")">
                                    @comment.CreatedAt.Humanize()
                                </abbr>
                            </div>
                            <div
                                class="legacy-comment-content">@Html.Raw(MarkdownRenderingService.Render(comment, comment.Id, comment.CreatedAt))</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
