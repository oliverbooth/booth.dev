@page "/blog/{slug}"
@using BoothDotDev.Data.Models
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using Humanizer
@inject BlogPostService BlogPostService
@inject MarkdownRenderingService MarkdownRenderingService
@model Article

@if (Model.ShowPasswordPrompt)
{
    <div class="callout" data-callout="danger">
        This post is private and can only be viewed by those with the password.
    </div>

    <form method="post">
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
    return;
}

@if (Model.Post is not { } post)
{
    return;
}

@{
    ViewData["Page"] = "Blog";
    ViewData["Post"] = post;
    ViewData["Title"] = post.Title;
    var author = post.Author;
    var published = post.Published;
    var category = BlogPostService.GetCategory(post.CategoryId)!;
}

<div class="page">

    <p class="crumb"><a asp-page="/Blog/Index">Write</a> / @post.Title</p>

    <span class="eyebrow">@category.Name</span>
    <h1 style="margin:8px 0 12px;font-size:30px">@post.Title</h1>

    <div class="byline">
        <div class="avatar">@author.DisplayName[0]</div>
        <span
            class="meta">@author.DisplayName &middot; @published.ToShortString() &middot; @post.GetEstimatedReadingTime() min read</span>
    </div>

    <div class="prose prose--@(category.FontStyle.ToString().ToLower())" style="margin-top:2.5rem">
        @Html.Raw(MarkdownRenderingService.Render(post, post.Id, post.Published))
    </div>

    @if (post.Tags.Count > 0)
    {
        <div style="border-top:0.5px solid var(--border);margin-top:2.5rem;padding-top:1.25rem;display:flex;gap:6px">
            @foreach (var tag in post.Tags)
            {
                <a asp-page="/Blog/Index" asp-route-tag="@tag" class="tag">@tag.Replace('-', ' ')</a>
            }
        </div>
    }
    
    @{
        var previousPost = BlogPostService.GetPreviousPost(post);
        var nextPost = BlogPostService.GetNextPost(post);
    }

    @if (previousPost is not null || nextPost is not null)
    {
        <div class="post-nav">
            @if (previousPost is not null)
            {
                <a asp-page="/Blog/Article" asp-route-slug="@previousPost.Slug" class="post-nav-link">
                    <span class="post-nav-label"><i class="ti ti-chevron-left"></i> Previous</span>
                    <span class="post-nav-title">@previousPost.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty"></div>
            }

            @if (nextPost is not null)
            {
                <a asp-page="/Blog/Article" asp-route-slug="@nextPost.Slug" class="post-nav-link post-nav-link--next">
                    <span class="post-nav-label">Next <i class="ti ti-chevron-right"></i></span>
                    <span class="post-nav-title">@nextPost.Title</span>
                </a>
            }
            else
            {
                <div class="post-nav-empty post-nav-empty--next"></div>
            }
        </div>
    }

    <a id="comments"></a>

    @if (post.EnableComments)
    {
        <div class="giscus"></div>

        @section Scripts
        {
            <script src="https://giscus.app/client.js"
                    data-repo="oliverbooth/booth.dev"
                    data-repo-id="MDEwOlJlcG9zaXRvcnkyNDUxODEyNDI="
                    data-category="Comments"
                    data-category-id="DIC_kwDODp0rOs4Ce_Nj"
                    data-mapping="pathname"
                    data-strict="0"
                    data-reactions-enabled="1"
                    data-emit-metadata="0"
                    data-input-position="bottom"
                    data-theme="dark"
                    data-lang="en"
                    crossorigin="anonymous"
                    async>
            </script>
        }
    }
    else
    {
        <p class="no-comment">Comments are not enabled for this post.</p>
    }

    @{
        var commentCount = BlogPostService.GetLegacyCommentCount(post);
        if (commentCount > 0)
        {
            <div class="legacy-comments-heading">
                <h2 style="margin:0">@("legacy comment".ToQuantity(commentCount))</h2>
                <p class="legacy-comments-subtitle">
                    Legacy comments were posted using a commenting system I no longer use. They exist here for posterity.
                </p>
            </div>

            var nestLevelMap = new Dictionary<LegacyComment, int>();
            var legacyComments = BlogPostService.GetLegacyComments(post);
            var comments = legacyComments.OrderByDescending(c => c.CreatedAt);
            var commentStack = new Stack<LegacyComment>(comments);

            <div class="legacy-comment-thread">
                @while (commentStack.Count > 0)
                {
                    var comment = commentStack.Pop();
                    var replies = BlogPostService.GetLegacyReplies(comment);
                    foreach (var reply in replies.OrderByDescending(c => c.CreatedAt))
                    {
                        if (nestLevelMap.TryGetValue(comment, out var currentLevel))
                        {
                            nestLevelMap[reply] = currentLevel + 1;
                        }
                        else
                        {
                            nestLevelMap[reply] = 1;
                        }

                        commentStack.Push(reply);
                    }

                    var isNested = nestLevelMap.ContainsKey(comment);
                    var avatarUrl = comment.GetAvatarUrl();

                    <div class="legacy-comment@(isNested ? " legacy-comment--nested" : "")">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img class="legacy-comment-avatar" src="@avatarUrl" alt="@comment.Author">
                        }
                        else
                        {
                            <div class="legacy-comment-avatar-fallback">@comment.Author[0]</div>
                        }
                        <div class="legacy-comment-body">
                            <div class="legacy-comment-header">
                                <span class="legacy-comment-author">@comment.Author</span>
                                <abbr class="legacy-comment-time"
                                      title="@comment.CreatedAt.ToString("dddd, d MMMM yyyy HH:mm")">
                                    @comment.CreatedAt.Humanize()
                                </abbr>
                            </div>
                            <div class="legacy-comment-content">@Html.Raw(MarkdownRenderingService.Render(comment, comment.Id, comment.CreatedAt))</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

