@page
@using BoothDotDev.Data
@using BoothDotDev.Services
@using Humanizer
@inject ReadingListService ReadingListService
@{
    ViewData["Title"] = "Reading List";
}

<div class="page">

    <p class="crumb"><a asp-page="/Index">Home</a> / Reading list</p>
    <h1>Reading list</h1>

    <div class="page-intro">
        <p>Books I've read, am reading, or plan to read. Not exhaustive. Updated whenever I remember to.</p>
        <p>Also on <a href="https://www.goodreads.com/review/list/145592619">Goodreads</a>.</p>
    </div>

    <div data-filter-scope>
        <div class="filter-row" id="reading-list-filters">
            <span class="pill active" data-filter="all">All</span>
            <span class="pill" data-filter="reading">Reading</span>
            <span class="pill" data-filter="plan-to-read">Plan to read</span>
            <span class="pill" data-filter="read">Read</span>
        </div>

        @{
            Span<BookState> states = [BookState.Reading, BookState.PlanToRead, BookState.Read];
            string[] filterKey = ["reading", "plan-to-read", "read"];
            string[] sectionIcon = ["book", "calendar-event", "check"];
            string[] sectionIconModifier = ["accent", "muted", "success"];
            string[] itemIcon = ["point-filled", "circle", "check"];
            string[] itemIconModifier = ["success", "muted", "success"];

            for (var index = 0; index < states.Length; index++)
            {
                var state = states[index];
                var books = ReadingListService.GetBooks(state);

                <div class="reading-list-section" data-state="@filterKey[index]">
                    <div class="section-inner">
                        <div class="section-head">
                            <h2>
                                <i class="ti ti-@sectionIcon[index] section-icon section-icon--@sectionIconModifier[index]"></i>
                                @state.Humanize(LetterCasing.Title)
                            </h2>
                        </div>

                        <div class="stack-list section-list">
                            @foreach (var book in books.OrderBy(b => b.Author).ThenBy(b => b.Title))
                            {
                                <div>
                                    <div class="stack-icon">
                                        <i class="ti ti-@itemIcon[index] item-icon item-icon--@itemIconModifier[index]"></i>
                                    </div>
                                    <div class="stack-meta stack-meta--row">
                                        <p class="title">
                                            @book.Title
                                            <br>
                                            <span class="stack-author">by @book.Author</span>
                                        </p>
                                        <a href="https://isbndb.com/book/@book.Isbn" class="isbn-link">@book.Isbn</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>