@page "/error/404"
<div class="error-page">
    <div class="error-card">

        <div class="terminal" style="margin-bottom:1.75rem">
            <div class="terminal-bar">
                <div class="terminal-dot"></div>
                <div class="terminal-dot"></div>
                <div class="terminal-dot"></div>
            </div>
            <div class="terminal-body">
                <div><span class="prompt">@Strings.TerminalUsername</span><span class="path">:~$</span> cat /app/data/this-page.md</div>
                <div class="out" style="margin-top:6px">cat: /app/data/this-page.md: No such file or directory</div>
            </div>
        </div>

        <p class="error-code">Error 404</p>
        <h1 class="error-title">Not Found</h1>
        <p class="error-desc">Nothing lives at this address. It might have moved, or never existed at all.</p>

        <div class="error-actions">
            <a asp-page="/Index" class="btn btn-primary">Back home</a>
            <a asp-page="/Blog/Index" class="btn">Read the blog</a>
        </div>

    </div>
</div>
