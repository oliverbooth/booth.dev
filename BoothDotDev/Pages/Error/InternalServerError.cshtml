@page "/error/500"
@using BoothDotDev.Pages.Shared.Partials

@{
    var hero = new ErrorHero
    {
        Code = 500,
        Title = "something broke on my end",
        Body = "Not you - me. Something went wrong on the server while handling this. I've probably already been notified. Try again in a bit.",
        Tag = "internal server error",
        Icon = "ti-bug",
        Tint = "danger",
        ShowRetry = true
    };
}

<partial name="Partials/_ErrorHero" model="hero" />
