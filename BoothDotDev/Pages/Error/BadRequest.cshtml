@page "/error/400"
<div class="error-page">
    <div class="error-card">

        <div class="terminal" style="margin-bottom:1.75rem">
            <div class="terminal-bar">
                <div class="terminal-dot"></div><div class="terminal-dot"></div><div class="terminal-dot"></div>
            </div>
            <div class="terminal-body">
                <div><span class="prompt">@Strings.TerminalUsername</span><span class="path">:~$</span> curl booth.dev/malformed?q=%</div>
                <div class="out" style="margin-top:6px">curl: (3) URL rejected: bad/illegal format or missing URL</div>
            </div>
        </div>

        <p class="error-code">Error 400</p>
        <h1 class="error-title">Bad Request</h1>
        <p class="error-desc">The request couldn't be understood as sent. Check the URL and try again.</p>

        <div class="error-actions">
            <a asp-page="/Index" class="btn btn-primary">Back home</a>
            <a asp-page="/Blog/Index" class="btn">Read the blog</a>
        </div>

    </div>
</div>