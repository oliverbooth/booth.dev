@page "/error/400"
@using BoothDotDev.Pages.Shared.Partials

@{
    var hero = new ErrorHero
    {
        Code = 400,
        Title = "that request got tangled",
        Body = "The server couldn't make sense of what was sent. Something in the request is malformed - check the URL or the data you submitted and try again.",
        Tag = "bad request",
        Icon = "ti-file-x",
        Tint = "warn",
        ShowRetry = true,
    };
}

<partial name="Partials/_ErrorHero" model="hero" />
