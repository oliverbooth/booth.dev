@page "/error/429"
@using BoothDotDev.Pages.Shared.Partials

@{
    var hero = new ErrorHero
    {
        Code = 429,
        Title = "slow down a little",
        Body = "Too many requests, too quickly. Give it a moment to cool off and try again shortly - the limit resets on its own.",
        Tag = "too many requests",
        Icon = "ti-hand-stop",
        Tint = "warn",
        ShowRetry = true
    };
}

<partial name="Partials/_ErrorHero" model="hero" />
