@page "/error/504"
@using BoothDotDev.Pages.Shared.Partials

@{
    var hero = new ErrorHero
    {
        Code = 504,
        Title = "that took too long",
        Body = "The server was waiting on something upstream that never answered in time. Could be a blip - worth trying again.",
        Tag = "gateway timeout",
        Icon = "ti-hourglass",
        Tint = "warn",
        ShowRetry = true
    };
}

<partial name="Partials/_ErrorHero" model="hero" />
