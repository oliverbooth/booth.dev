@page "/error/504"
<div class="error-page">
    <div class="error-card">

        <div class="terminal" style="margin-bottom:1.75rem">
            <div class="terminal-bar">
                <div class="terminal-dot"></div>
                <div class="terminal-dot"></div>
                <div class="terminal-dot"></div>
            </div>
            <div class="terminal-body">
                <div><span class="prompt">@Strings.TerminalUsername</span><span class="path">:~$</span> curl --max-time 30 booth.dev</div>
                <div class="out" style="margin-top:6px">curl: (28) Operation timed out after 30000 milliseconds</div>
            </div>
        </div>

        <p class="error-code">Error 504</p>
        <h1 class="error-title">Gateway Timeout</h1>
        <p class="error-desc">The upstream took too long to respond. Could be a slow connection, could be the server &mdash; try again.</p>

        <div class="error-actions">
            <a asp-page="/Index" class="btn btn-primary">Back home</a>
            <a asp-page="/Blog/Index" class="btn">Read the blog</a>
        </div>

    </div>
</div>
