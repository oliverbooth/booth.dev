@page "/error/503"
@using BoothDotDev.Pages.Shared.Partials

@{
    var hero = new ErrorHero
    {
        Code = 503,
        Title = "back in a moment",
        Body = "The server's temporarily unavailable - likely a deploy, maintenance, or just too much load right now. This should clear up shortly.",
        Tag = "service unavailable",
        Icon = "ti-tool",
        Tint = "warn",
        ShowRetry = true
    };
}

<partial name="Partials/_ErrorHero" model="hero" />
