@page "/admin/watchlist/edit/{id:guid?}"
@using BoothDotDev.Data
@using Humanizer
@model Edit

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <p class="crumb"><a asp-page="/Admin/Watchlist/Index">Watchlist</a> / @(Model.CreatingNew ? "New entry" : "Edit")</p>

    <form class="form-grid" method="post">

        <div asp-validation-summary="All"></div>

        <div class="admin-header">
            <div><h1>@(Model.CreatingNew ? "New entry" : Model.Input.Title)</h1></div>
            <div style="display:flex;gap:8px">
                <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Save</button>
            </div>
        </div>

        @if (Model.CreatingNew)
        {
            <div class="field">
                <label for="lookup-query">Look up by title</label>
                <div class="input-with-button">
                    <input type="text" id="lookup-query" placeholder="Dungeon Crawler Carl">
                    <button type="button" class="btn" id="lookup-btn"><i class="ti ti-search"></i> Search</button>
                </div>
                <p class="hint" id="lookup-hint" hidden></p>
                <ul class="draft-list lookup-results" id="lookup-results" hidden></ul>
            </div>
        }

        <div class="field-row">
            <div class="field">
                <label for="title">Title</label>
                <input type="text" id="title" asp-for="Input.Title" data-watchable-field="title">
            </div>
            <div class="field">
                <label asp-for="Input.Kind">Kind</label>
                <select asp-for="Input.Kind" data-watchable-field="kind">
                    @foreach (var kind in Enum.GetValues<WatchableKind>())
                    {
                        <option value="@kind">@kind.Humanize(LetterCasing.Title)</option>
                    }
                </select>
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.State">State</label>
            <select asp-for="Input.State">
                @foreach (var state in Enum.GetValues<WatchableState>())
                {
                    <option value="@state">@state.Humanize(LetterCasing.Title)</option>
                }
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Save</button>
        </div>

    </form>

    @if (!Model.CreatingNew)
    {
        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id"
              data-confirm="Remove '@Model.Input.Title' from the watchlist?" style="margin-top:1rem">
            <button type="submit" class="btn icon-btn danger" aria-label="Delete"><i class="ti ti-trash"></i> Delete</button>
        </form>
    }

</div>
