@page "/admin/watchlist"
@using BoothDotDev.Data
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Watchlist</h1>
            <p>Add, update, and remove entries on the movie/TV watchlist</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Watchlist/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New entry</a>
        </div>
    </div>

    @if (Model.TraktError is { } traktError)
    {
        <div class="callout" data-callout="danger">
            <p class="callout-title"><i class="ti ti-alert-triangle"></i> Trakt</p>
            <div class="callout-body"><p>@traktError</p></div>
        </div>
    }

    @if (Model.TraktMessage is { } traktMessage)
    {
        <div class="callout" data-callout="success">
            <p class="callout-title"><i class="ti ti-check"></i> Trakt</p>
            <div class="callout-body"><p>@traktMessage</p></div>
        </div>
    }

    <div class="admin-header">
        <div>
            <h2 style="margin:0">Trakt</h2>
            <p>@(Model.IsTraktConnected ? "Connected - pull whenever your Trakt watchlist or history changes." : "Not connected yet.")</p>
        </div>
        <div style="display:flex;gap:8px">
            @if (Model.IsTraktConnected)
            {
                <form method="post" asp-page-handler="SyncTrakt">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-refresh"></i> Pull from Trakt</button>
                </form>
            }
            else if (Model.PendingChallenge is null)
            {
                <form method="post" asp-page-handler="ConnectTrakt">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-link"></i> Connect Trakt</button>
                </form>
            }
        </div>
    </div>

    @if (Model.PendingChallenge is { } challenge)
    {
        <div class="callout" data-callout="info">
            <p class="callout-title"><i class="ti ti-key"></i> Finish connecting Trakt</p>
            <div class="callout-body">
                <p>
                    Go to <a href="@challenge.VerificationUrl" target="_blank">@challenge.VerificationUrl</a> and enter this code:
                    <code style="font-size:16px">@challenge.UserCode</code>
                </p>
                <form method="post" asp-page-handler="CheckTraktAuth">
                    <button type="submit" class="btn"><i class="ti ti-refresh"></i> I've done that &ndash; check now</button>
                </form>
            </div>
        </div>
    }

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search watchlist&hellip;">
            </div>
        </div>

        <table class="data-table">
            <thead>
            <tr>
                <th>Title</th>
                <th>Kind</th>
                <th>State</th>
                <th style="text-align:right">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Watchables)
            {
                <tr>
                    <td>
                        <div class="row-title" data-search>@item.Title</div>
                    </td>
                    <td data-search>@item.Kind.Humanize(LetterCasing.Title)</td>
                    <td>
                        <form method="post" asp-page-handler="SetState" asp-route-id="@item.Id" class="row-actions"
                              style="justify-content:flex-start">
                            <select name="state" aria-label="State" class="inline-select">
                                @foreach (var state in Enum.GetValues<WatchableState>())
                                {
                                    <option value="@state" selected="@(state == item.State)">@state.Humanize(LetterCasing.Title)</option>
                                }
                            </select>
                            <button type="submit" class="icon-btn" aria-label="Update state"><i class="ti ti-check"></i></button>
                        </form>
                    </td>
                    <td>
                        <div class="row-actions">
                            <a asp-page="/Admin/Watchlist/Edit" asp-route-id="@item.Id" class="icon-btn" aria-label="Edit">
                                <i class="ti ti-edit"></i>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                                  data-confirm="Remove '@item.Title' from the watchlist?">
                                <button type="submit" class="icon-btn danger" aria-label="Delete"><i class="ti ti-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            <tr data-search-empty hidden>
                <td colspan="4" class="table-empty-state">No watchlist entries found</td>
            </tr>
            </tbody>
        </table>
    </div>

</div>
