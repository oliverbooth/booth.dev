@page "/admin/notes"
@using BoothDotDev.Data
@using DEDrake
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Notes</h1>
            <p>Create, edit, and delete notes</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Notes/Trash" class="btn icon-btn"><i class="ti ti-trash" style="font-size:15px"></i>Trash</a>
            <a asp-page="/Admin/Notes/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New note</a>
        </div>
    </div>

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search notes&hellip;">
            </div>
        </div>

        <ul class="admin-row-list">
            @foreach (var note in Model.Notes)
            {
                var timestamp = note.UpdatedAt ?? note.PublishedAt;

                <li class="admin-row" data-search-item>
                    <partial name="Partials/_VisibilityBadge" model="note.Visibility" />
                    <div class="row-body">
                        <div class="row-title" data-search>@note.Title</div>
                    </div>
                    <span class="row-meta"><abbr title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.Humanize()</abbr></span>
                    <div class="row-actions">
                        <a asp-page="/Admin/Notes/Edit" asp-route-id="@note.Id" class="icon-btn">edit</a>
                        <a asp-page="/Note" asp-route-id="@((ShortGuid)note.Id)" class="icon-btn">view</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@note.Id">
                            <button type="submit" class="icon-btn danger">delete</button>
                        </form>
                    </div>
                </li>
            }
            <li class="list-empty-state" data-search-empty hidden>No notes found</li>
        </ul>
    </div>

</div>
