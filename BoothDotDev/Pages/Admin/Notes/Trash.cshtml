@page "/admin/notes/trash"
@using BoothDotDev.Data
@using Humanizer
@model Trash

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <p class="crumb"><a asp-page="/Admin/Notes/Index">Notes</a> / Trash</p>

    <div class="admin-header">
        <div>
            <h1>Trash</h1>
            <p>Trashed notes are hidden from the public site until restored</p>
        </div>
        <a asp-page="/Admin/Notes/Index" class="btn btn-primary"><i class="ti ti-arrow-left" style="font-size:15px"></i>Back to notes</a>
    </div>

    @if (Model.Notes.Count == 0)
    {
        <p class="table-empty-state">Trash is empty</p>
    }
    else
    {
        <div data-search-scope data-bulk-select-scope>
            <div class="table-toolbar">
                <div class="search-input">
                    <i class="ti ti-search"></i>
                    <input type="text" id="search" placeholder="Search trash&hellip;">
                </div>
                <label class="select-all-label">
                    <input type="checkbox" data-select-all aria-label="Select all">
                    select all
                </label>
            </div>

            <div class="bulk-actions" data-bulk-actions hidden>
                <span><span data-selected-count>0</span> selected</span>
                <button type="submit" form="bulk-delete-form" class="btn icon-btn danger" aria-label="Delete permanently">
                    <i class="ti ti-trash-x"></i> Delete permanently
                </button>
            </div>
            <form id="bulk-delete-form" method="post" asp-page-handler="PermanentlyDeleteBulk"
                  data-confirm="Permanently delete {count} note(s)? This cannot be undone."></form>

            <ul class="admin-row-list">
                @foreach (var note in Model.Notes)
                {
                    <li class="admin-row" data-search-item>
                        <input type="checkbox" name="ids" value="@note.Id" form="bulk-delete-form" data-row-select
                               aria-label="Select @note.Title">
                        <partial name="Partials/_VisibilityBadge" model="note.Visibility" />
                        <div class="row-body">
                            <div class="row-title" data-search>@note.Title</div>
                        </div>
                        <span class="row-meta">
                            <abbr title="@note.TrashedAt!.Value.ToString("yyyy-MM-dd HH:mm:ss")">@note.TrashedAt!.Value.Humanize()</abbr>
                        </span>
                        <div class="row-actions">
                            <a asp-page="/Admin/Notes/Edit" asp-route-id="@note.Id" class="icon-btn">edit</a>
                            <form method="post" asp-page-handler="Restore" asp-route-id="@note.Id">
                                <button type="submit" class="icon-btn">restore</button>
                            </form>
                            <form method="post" asp-page-handler="PermanentlyDelete" asp-route-id="@note.Id"
                                  data-confirm="Permanently delete '@note.Title'? This cannot be undone.">
                                <button type="submit" class="icon-btn danger">delete</button>
                            </form>
                        </div>
                    </li>
                }
                <li class="list-empty-state" data-search-empty hidden>No notes found</li>
            </ul>
        </div>
    }

</div>
