@page "/admin"
@using System.Diagnostics
@using BoothDotDev.Data
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Dashboard</h1>
            <p>An overview of everything on the site.</p>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <p class="label">Posts</p>
            <p class="value">@Model.BlogPostCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Notes</p>
            <p class="value">@Model.NoteCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Tutorials</p>
            <p class="value">@Model.TutorialCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Projects</p>
            <p class="value">@Model.ProjectCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Devlogs</p>
            <p class="value">@Model.DevlogCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Books</p>
            <p class="value">@Model.BookCount</p>
        </div>
        <div class="stat-card">
            <p class="label">Watchlist</p>
            <p class="value">@Model.WatchableCount</p>
        </div>
    </div>

    <div class="admin-header">
        <div><h2 style="margin:0">Recent activity</h2></div>
    </div>

    <ul class="admin-row-list">
        @foreach (var activity in Model.RecentActivity)
        {
            var timestamp = activity.UpdatedAt ?? activity.PublishedAt;
            var badgeClass = activity.Visibility switch
            {
                Visibility.Published => "published",
                Visibility.Private => "private",
                _ => "unlisted"
            };

            <li class="admin-row">
                <span class="badge badge-@badgeClass">
                    @switch (activity.Visibility)
                        {
                            case Visibility.Published:
                                <text><span class="dot"></span> Published</text>
                                break;

                            case Visibility.Private:
                                <text><i class="ti ti-lock"></i> Private</text>
                                break;

                            case Visibility.Unlisted:
                                <text><i class="ti ti-eye-off"></i> Unlisted</text>
                                break;

                            default:
                                throw new UnreachableException();
                        }
                </span>
                <div class="row-body">
                    <div class="row-title">@activity.Title</div>
                    <div class="row-sub">@activity.Category.Humanize()</div>
                </div>
                <span class="row-meta"><abbr title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.Humanize()</abbr></span>
                <div class="row-actions">
                    <a asp-page="@activity.PagePath" asp-all-route-data="activity.RouteValues" class="icon-btn">view</a>
                </div>
            </li>
        }
    </ul>

</div>
