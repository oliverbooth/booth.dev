@page "/admin/login/2fa"
@model LoginTotp
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <script>
        // runs before first paint to avoid a flash of the wrong theme; keep in step with resolveTheme() in theme.ts
        (() => {
            let theme = null;
            try {
                theme = localStorage.getItem('theme');
            } catch {
            }

            if (theme !== 'light' && theme !== 'dark') {
                theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }

            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <title>Sign in - @Strings.MyName Admin</title>
    <link rel="icon" href="~/img/favicon.png" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.47.0/tabler-icons.min.css">
    <link rel="stylesheet" asp-vite="css/style.css" />
    <link rel="stylesheet" asp-vite="css/admin.css" />
</head>
<body>

<div class="login-shell">
    <div class="login-stack">

        <div class="login-card">
            <div class="login-mark">@Strings.MyFirstName[0]@Strings.MySurname[0]</div>
            <h1>Verify it's you</h1>
            <p class="sub">@Strings.MyName &middot; admin</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="login-error"></div>

                <div class="field">
                    <label asp-for="TotpCode">Authenticator code</label>
                    <input asp-for="TotpCode"
                           type="text"
                           autocomplete="one-time-code"
                           required
                           inputmode="numeric"
                           pattern="[0-9]*"
                           autofocus />
                </div>

                <button type="submit" class="btn btn-primary" style="justify-content:center">Sign in</button>
            </form>

            <p class="login-footnote">This area is for site administration only</p>
        </div>

        <a asp-page="/Index" class="login-back-link">&larr; back to the actual site</a>
    </div>
</div>

<vite-hmr-client />
<script asp-vite="ts/admin.ts"></script>
</body>
</html>
