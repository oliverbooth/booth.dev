@page "/admin/someday/edit/{id:guid?}"
@using BoothDotDev.Data
@using Humanizer
@model Edit

@{
    Layout = "_AdminLayout";
    var entryModel = Model.Input;
}

<div class="admin-page admin-page--split">

    <p class="crumb"><a asp-page="/Admin/Someday/Index">Someday</a> / Edit</p>

    <form class="form-grid" method="post">

        <div asp-validation-summary="All"></div>

        @if (Model.IsTrashed)
        {
            <div class="callout" data-callout="danger">
                <p class="callout-title"><i class="ti ti-trash"></i> This entry is trashed</p>
                <div class="callout-body">
                    <p>It's hidden from the someday page. Restore it to bring it back.</p>
                </div>
            </div>
        }

        <div class="admin-header">
            <div><h1>@(Model.CreatingNew ? "New entry" : $"Someday, {entryModel.Title}")</h1></div>
            <div style="display:flex;gap:8px">
                @if (!Model.CreatingNew)
                {
                    <a asp-page="/Someday" asp-fragment="@entryModel.Slug" target="_blank" class="btn">
                        <i class="ti ti-eye"></i> View on someday page
                    </a>
                }
                <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Publish changes</button>
            </div>
        </div>

        <div class="field">
            <label for="entry-title">Title</label>
            <div class="input-with-button">
                <span class="input-prefix">Someday,</span>
                <input type="text" id="entry-title" asp-for="Input.Title" placeholder="I would like to&hellip;">
            </div>
        </div>

        <div class="field">
            <label for="body">Body (markdown supported)</label>
            <textarea id="body" rows="16" asp-for="Input.Body" data-markdown data-preview-source></textarea>
        </div>

        <div class="field-row">
            <div class="field">
                <label for="slug">Slug</label>
                <input type="text" id="slug" asp-for="Input.Slug" placeholder="work-for-the-craft">
                <p class="hint">Used as this entry's anchor on the someday page. Set once - changing the title later won't move it.</p>
            </div>
            <div class="field">
                <label asp-for="Input.Visibility">Visibility</label>
                <select asp-for="Input.Visibility">
                    @{
                        var visibilities = Enum.GetValues<Visibility>().Except([Visibility.None]);
                        foreach (var visibility in visibilities)
                        {
                            <option value="@visibility">@visibility</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Publish changes</button>
            <button type="submit" class="btn" asp-page-handler="SaveDraft"><i class="ti ti-device-floppy"></i> Save as draft</button>
            @if (!Model.CreatingNew)
            {
                @if (Model.IsTrashed)
                {
                    <button type="submit" class="btn" asp-page-handler="Restore">
                        <i class="ti ti-trash-off"></i> Restore
                    </button>
                }
                else
                {
                    <button type="submit" class="btn icon-btn danger" asp-page-handler="Delete" aria-label="Move to trash">
                        <i class="ti ti-trash"></i> Move to trash
                    </button>
                }
            }
        </div>

        <section class="admin-media" id="content-media">
            <div class="admin-header">
                <div><h2>Media</h2></div>
                @if (!Model.CreatingNew)
                {
                    <div style="display:flex;gap:8px">
                        <input type="file" id="media-file-input" hidden>
                        <button type="button" class="btn btn-primary" id="media-upload-btn">
                            <i class="ti ti-upload"></i>Upload file
                        </button>
                    </div>
                }
            </div>

            @if (Model.CreatingNew)
            {
                <p class="hint">Save this entry before attaching media.</p>
            }
            else
            {
                <p class="hint">
                    Reference an uploaded file from the body above by its filename, e.g. <code>![alt text](filename.png)</code>.
                    Images have their EXIF metadata stripped automatically on upload.
                </p>
                <p class="hint" id="media-error" hidden></p>
                <ul class="media-list" id="media-list"></ul>
            }
        </section>

        <section class="admin-drafts" id="someday-entry-drafts">
            <div class="admin-header">
                <div><h2>Revision history</h2></div>
            </div>

            @if (Model.CreatingNew)
            {
                <p class="hint">Save this entry to start its revision history.</p>
            }
            else
            {
                <p class="hint">
                    Viewing an older revision loads it into the form above - nothing is saved until you hit Publish changes or Save as
                    draft.
                </p>
                <ul class="draft-list">
                    @foreach (var draft in Model.DraftHistory)
                    {
                        var isPublished = draft.Id == Model.CurrentDraftId;
                        var isViewing = draft.Id == Model.ViewingDraftId;

                        <li class="draft-item">
                            <a class="draft-item-link" aria-current="@(isViewing ? "true" : null)"
                               asp-page="Edit" asp-route-id="@Model.EntryId" asp-route-draftId="@draft.Id">
                                <div class="draft-item-body">
                                    <p class="name">Someday, @draft.Title</p>
                                    <p class="meta">@draft.CreatedAt.Humanize()</p>
                                </div>
                                @if (isPublished)
                                {
                                    <span class="badge badge-published">Published</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

    </form>

    <aside class="admin-preview" id="preview-pane">
        <span class="eyebrow">Preview</span>
        <h1 id="preview-title">Someday, @entryModel.Title</h1>
        <div class="prose prose--serif" id="preview-body"></div>
    </aside>

</div>
