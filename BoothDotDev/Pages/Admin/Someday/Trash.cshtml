@page "/admin/someday/trash"
@using System.Diagnostics
@using BoothDotDev.Data
@using Humanizer
@model Trash

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <p class="crumb"><a asp-page="/Admin/Someday/Index">Someday</a> / Trash</p>

    <div class="admin-header">
        <div>
            <h1>Trash</h1>
            <p>Trashed entries are hidden from the someday page until restored</p>
        </div>
        <a asp-page="/Admin/Someday/Index" class="btn btn-primary"><i class="ti ti-arrow-left" style="font-size:15px"></i>Back to
            someday</a>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <p class="table-empty-state">Trash is empty</p>
    }
    else
    {
        <div data-search-scope data-bulk-select-scope>
            <div class="table-toolbar">
                <div class="search-input">
                    <i class="ti ti-search"></i>
                    <input type="text" id="search" placeholder="Search trash&hellip;">
                </div>
                <label class="select-all-label">
                    <input type="checkbox" data-select-all aria-label="Select all">
                    select all
                </label>
            </div>

            <div class="bulk-actions" data-bulk-actions hidden>
                <span><span data-selected-count>0</span> selected</span>
                <button type="submit" form="bulk-delete-form" class="btn icon-btn danger" aria-label="Delete permanently">
                    <i class="ti ti-trash-x"></i> Delete permanently
                </button>
            </div>
            <form id="bulk-delete-form" method="post" asp-page-handler="PermanentlyDeleteBulk"
                  data-confirm="Permanently delete {count} entry(s)? This cannot be undone."></form>

            <ul class="admin-row-list">
                @foreach (var entry in Model.Entries)
                {
                    var badgeClass = entry.Visibility switch
                    {
                        Visibility.Published => "published",
                        Visibility.Private => "private",
                        _ => "unlisted"
                    };

                    <li class="admin-row" data-search-item>
                        <input type="checkbox" name="ids" value="@entry.Id" form="bulk-delete-form" data-row-select
                               aria-label="Select @entry.Title">
                        <span class="badge badge-@badgeClass">
                        @switch (entry.Visibility)
                                {
                                    case Visibility.Published:
                                        <text><span class="dot"></span> Published</text>
                                        break;

                                    case Visibility.Private:
                                        <text><i class="ti ti-lock"></i> Private</text>
                                        break;

                                    case Visibility.Unlisted:
                                        <text><i class="ti ti-eye-off"></i> Unlisted</text>
                                        break;

                                    default:
                                        throw new UnreachableException();
                                }
                        </span>
                        <div class="row-body">
                            <div class="row-title" data-search>Someday, @entry.Title</div>
                        </div>
                        <span class="row-meta">
                            <abbr title="@entry.TrashedAt!.Value.ToString("yyyy-MM-dd HH:mm:ss")">@entry.TrashedAt!.Value.Humanize()</abbr>
                        </span>
                        <div class="row-actions">
                            <a asp-page="/Admin/Someday/Edit" asp-route-id="@entry.Id" class="icon-btn">edit</a>
                            <form method="post" asp-page-handler="Restore" asp-route-id="@entry.Id">
                                <button type="submit" class="icon-btn">restore</button>
                            </form>
                            <form method="post" asp-page-handler="PermanentlyDelete" asp-route-id="@entry.Id"
                                  data-confirm="Permanently delete 'Someday, @entry.Title'? This cannot be undone.">
                                <button type="submit" class="icon-btn danger">delete</button>
                            </form>
                        </div>
                    </li>
                }
                <li class="list-empty-state" data-search-empty hidden>No entries found</li>
            </ul>
        </div>
    }

</div>
