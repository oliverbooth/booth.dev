@page "/admin/login"
@using BoothDotDev.Data
@using Microsoft.Extensions.Options
@model Login
@inject IOptionsMonitor<SiteOptions> Site
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <script>
        // runs before first paint to avoid a flash of the wrong theme; keep in step with resolveTheme() in theme.ts
        (() => {
            let theme = null;
            try {
                theme = localStorage.getItem('theme');
            } catch {
            }

            if (theme !== 'light' && theme !== 'dark') {
                theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }

            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <title>@(Site.CurrentValue.EnvironmentLabel is { Length: > 0 } environmentLabel ? $"[{environmentLabel}] " : "")Sign in
        - @Strings.MyName Admin</title>
    <link rel="icon" href="~/img/favicon.png" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.47.0/tabler-icons.min.css">
    <link rel="stylesheet" asp-vite="css/style.css" />
    <link rel="stylesheet" asp-vite="css/admin.css" />
</head>
<body>
@if (!string.IsNullOrWhiteSpace(Site.CurrentValue.EnvironmentLabel))
{
    <div class="env-bar" aria-hidden="true"></div>
}

<div class="login-shell">
    <div class="login-stack">

        <div class="login-card">
            <div class="login-mark">@Strings.MyFirstName[0]@Strings.MySurname[0]</div>
            <h1>Admin sign in</h1>
            <p class="sub">@Strings.MyName &middot; admin</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="login-error"></div>
                <p class="login-error validation-summary-errors" id="passkey-error" hidden></p>

                <button type="button" class="btn btn-primary" id="passkey-login-btn" style="justify-content:center">
                    <i class="ti ti-fingerprint"></i> Sign in with a passkey
                </button>

                <div class="login-divider">or</div>

                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" autocomplete="username" required autofocus />
                </div>

                <div class="field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn" style="justify-content:center">Sign in</button>
            </form>

            <p class="login-footnote">This area is for site administration only</p>
        </div>

        <a asp-page="/Index" class="login-back-link">&larr; back to the actual site</a>
    </div>
</div>

<vite-hmr-client />
<script asp-vite="ts/admin.ts"></script>
</body>
</html>
