@page "/admin/gamelist/edit/{id:guid?}"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using Humanizer
@model Edit

@{
    Layout = "_AdminLayout";
    const string templateIndex = "__index__";
}

<div class="admin-page">

    <p class="crumb"><a asp-page="/Admin/Gamelist/Index">Game list</a> / @(Model.CreatingNew ? "New entry" : "Edit")</p>

    <form class="form-grid" method="post">

        <div asp-validation-summary="All"></div>

        <div class="admin-header">
            <div><h1>@(Model.CreatingNew ? "New entry" : Model.Input.Title)</h1></div>
            <div style="display:flex;gap:8px">
                <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Save</button>
            </div>
        </div>

        @if (Model.CreatingNew)
        {
            <div class="field">
                <label for="lookup-query">Look up by title</label>
                <div class="input-with-button">
                    <input type="text" id="lookup-query" placeholder="Hollow Knight">
                    <button type="button" class="btn" id="lookup-btn"><i class="ti ti-search"></i> Search</button>
                </div>
                <p class="hint" id="lookup-hint" hidden></p>
                <ul class="draft-list lookup-results" id="lookup-results" hidden></ul>
            </div>
        }

        <div class="field">
            <label for="title">Title</label>
            <input type="text" id="title" asp-for="Input.Title" data-playable-field="title">
        </div>

        <partial name="Partials/_SortTitleField" model="Model.Input.SortTitle" />

        <div class="field">
            <label asp-for="Input.State">State</label>
            <select asp-for="Input.State">
                @foreach (var state in Enum.GetValues<PlayableState>())
                {
                    <option value="@state">@state.Humanize(LetterCasing.Title)</option>
                }
            </select>
        </div>

        @foreach (var group in Enum.GetValues<GamePlatform>().GroupBy(p => p.Group))
        {
            <div class="field">
                <label>@group.Key</label>
                <div class="segmented">
                    @foreach (var platform in group)
                    {
                        <label class="segmented-option">
                            <input type="checkbox" name="Input.Platforms" value="@platform"
                                   checked="@Model.Input.Platforms.Contains(platform)">
                            <span>@platform.DisplayName</span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="field">
            <label asp-for="Input.Igdb">IGDB</label>
            <input type="text" asp-for="Input.Igdb" data-playable-field="igdb" placeholder="Slug or igdb.com link"
                   autocomplete="off">
            <p class="hint">
                Links this entry to its IGDB page. Leave empty to unlink.
                @if (Model.IgdbUrl is { } igdbUrl)
                {
                    <a href="@igdbUrl" class="meta-link" target="_blank" rel="noopener">Check current match <i
                            class="ti ti-external-link"></i></a>
                }
            </p>
        </div>

        <div class="field" data-editions>
            <label>Other editions</label>
            <p class="hint">
                Only for a game you've also played in another edition, such as a remaster or director's cut. Each edition has its
                own platforms. The fields above describe the original, or the only edition you've played.
            </p>
            <div class="edition-list-admin" data-edition-list>
                @for (var index = 0; index < Model.Input.Editions.Count; index++)
                {
                    <partial name="_EditionBlock" model="new Edit.EditionBlock(index.ToString(), Model.Input.Editions[index])" />
                }
            </div>
            <button type="button" class="btn" data-edition-add><i class="ti ti-plus"></i> Add edition</button>
            <template data-edition-template>
                <partial name="_EditionBlock" model="new Edit.EditionBlock(templateIndex, new Edit.EditionModel())" />
            </template>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" asp-page-handler="Save"><i class="ti ti-cloud"></i> Save</button>
        </div>

    </form>

    @if (!Model.CreatingNew)
    {
        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id"
              data-confirm="Remove '@Model.Input.Title' from the game list?" style="margin-top:1rem">
            <button type="submit" class="btn icon-btn danger" aria-label="Delete"><i class="ti ti-trash"></i> Delete</button>
        </form>
    }

</div>
