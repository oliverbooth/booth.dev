@page "/admin/projects"
@using BoothDotDev.Data
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Projects</h1>
            <p>Manage your portfolio projects and their devlog entries</p>
        </div>
        <a asp-page="/Admin/Projects/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New project</a>
    </div>

    @if (Model.DeleteError is { } error)
    {
        <div class="callout" data-callout="danger">
            <p class="callout-title"><i class="ti ti-alert-triangle"></i> Couldn't delete project</p>
            <div class="callout-body"><p>@error</p></div>
        </div>
    }

    @if (Model.Projects.Count == 0)
    {
        <p class="table-empty-state">No projects yet</p>
    }
    else
    {
        <div data-search-scope>
            <div class="table-toolbar">
                <div class="search-input">
                    <i class="ti ti-search"></i>
                    <input type="text" id="search" placeholder="Search projects&hellip;">
                </div>
            </div>

            <ul class="admin-row-list">
                @foreach (var project in Model.Projects)
                {
                    var statusClass = project.Status switch
                    {
                        ProjectStatus.Ongoing => "published",
                        ProjectStatus.Hiatus => "unlisted",
                        ProjectStatus.Past => "unlisted",
                        ProjectStatus.Retired => "private",
                        _ => "unlisted"
                    };

                    <li class="admin-row" data-search-item>
                        <span class="badge badge-@statusClass"><span class="dot"></span> @project.Status</span>
                        <div class="row-body">
                            <div class="row-title" data-search>@project.Name</div>
                            <div class="row-sub" data-search>@project.Type</div>
                        </div>
                        <div class="row-actions">
                            <a asp-page="/Admin/Projects/Edit" asp-route-id="@project.Id" class="icon-btn">edit</a>
                            <a asp-page="/Portfolio/Item" asp-route-slug="@project.Slug" target="_blank" class="icon-btn">view</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@project.Id"
                                  data-confirm="Delete '@project.Name'? This can't be undone.">
                                <button type="submit" class="icon-btn danger">delete</button>
                            </form>
                        </div>
                    </li>
                }
                <li class="list-empty-state" data-search-empty hidden>No projects found</li>
            </ul>
        </div>
    }

</div>
