@page "/admin/cdn"
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>CDN</h1>
            <p>Browse and manage files on the CDN</p>
        </div>
        <div style="display:flex;gap:8px">
            <button type="button" id="cdn-new-folder-btn" class="btn icon-btn">
                <i class="ti ti-folder-plus" style="font-size:15px"></i>New folder
            </button>
            <button type="button" id="cdn-upload-btn" class="btn btn-primary">
                <i class="ti ti-upload" style="font-size:15px"></i>Upload
            </button>
            <input type="file" id="cdn-file-input" multiple hidden />
        </div>
    </div>

    <p class="login-error validation-summary-errors" id="cdn-error" hidden></p>

    <form method="post" id="cdn-form" hidden></form>

    <nav class="path-builder" aria-label="Breadcrumb">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i == Model.Breadcrumbs.Count - 1)
            {
                <span class="path-crumb">@crumb.Name</span>
            }
            else
            {
                <a asp-page="/Admin/Cdn/Index" asp-route-path="@crumb.Path" class="path-crumb">@crumb.Name</a>
                <span class="path-sep">/</span>
            }
        }
    </nav>

    <div data-search-scope id="cdn-browser" data-current-path="@Model.CurrentDisplayPath">
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search this folder&hellip;">
            </div>
        </div>

        <ul class="cdn-grid" id="cdn-grid">
            @foreach (var entry in Model.Entries)
            {
                <li class="cdn-tile" draggable="true" data-kind="@(entry.IsDirectory ? "folder" : "file")" data-name="@entry.Name"
                    data-search-item>
                    <i class="ti @Index.GetIcon(entry) cdn-tile-icon"></i>
                    @if (entry.IsDirectory)
                    {
                        <a asp-page="/Admin/Cdn/Index" class="cdn-tile-name" data-search
                           asp-route-path="@($"{Model.CurrentDisplayPath}/{entry.Name}".TrimStart('/'))">@entry.Name</a>
                    }
                    else
                    {
                        <span class="cdn-tile-name" data-search>@entry.Name</span>
                    }
                    <span class="cdn-tile-meta">
                        @(entry.IsDirectory ? "item".ToQuantity(entry.ItemCount ?? 0) : Index.FormatFileSize(entry.SizeBytes ?? 0))
                        &middot;
                        <abbr title="@entry.ModifiedAt.ToString("yyyy-MM-dd HH:mm:ss")">@entry.ModifiedAt.Humanize()</abbr>
                    </span>
                    <div class="cdn-tile-actions">
                        @if (!entry.IsDirectory)
                        {
                            <a href="@entry.Url" target="_blank" rel="noopener" class="icon-btn" aria-label="View"><i
                                    class="ti ti-external-link"></i></a>
                        }
                        <button type="button" class="icon-btn" data-action="rename" aria-label="Rename"><i class="ti ti-edit"></i>
                        </button>
                        <button type="button" class="icon-btn" data-action="move" aria-label="Move"><i class="ti ti-arrows-move"></i>
                        </button>
                        <button type="button" class="icon-btn danger" data-action="delete" aria-label="Delete"><i
                                class="ti ti-trash"></i></button>
                    </div>
                </li>
            }
        </ul>
        <p class="list-empty-state" data-search-empty hidden="@(Model.Entries.Count != 0)">
            @(Model.Entries.Count == 0 ? "This folder is empty" : "No files or folders found")
        </p>
    </div>

</div>
