@page "/admin/users"
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Users</h1>
            <p>Manage user accounts and contributors</p>
        </div>
        <a asp-page="/Admin/Users/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New user</a>
    </div>

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search users&hellip;">
            </div>
        </div>

        <ul class="admin-row-list">
            @foreach (var user in Model.Users)
            {
                var loginEnabled = !string.IsNullOrWhiteSpace(user.Password);
                var totpEnabled = !string.IsNullOrWhiteSpace(user.TotpSecret);

                <li class="admin-row" data-search-item>
                    <div class="row-body row-title--avatar" data-search>
                        <div class="avatar" data-initial="@user.DisplayName[0]">
                            <img src="@user.AvatarUrl" alt="@user.DisplayName" />
                        </div>
                        <div>
                            <div class="row-title">@user.DisplayName</div>
                            <div class="row-sub" data-search>@user.EmailAddress</div>
                        </div>
                    </div>
                    @if (loginEnabled)
                    {
                        <span class="badge badge-published"><span class="dot"></span> Login enabled</span>
                    }
                    else
                    {
                        <span class="badge badge-private"><i class="ti ti-lock"></i> Login disabled</span>
                    }
                    @if (totpEnabled)
                    {
                        <span class="badge badge-published"><span class="dot"></span> 2FA on</span>
                    }
                    else
                    {
                        <span class="badge badge-unlisted"><i class="ti ti-eye-off"></i> 2FA off</span>
                    }
                    <div class="row-actions">
                        <a asp-page="/Admin/Users/Edit" asp-route-id="@user.Id" class="icon-btn">edit</a>
                    </div>
                </li>
            }
            <li class="list-empty-state" data-search-empty hidden>No users found</li>
        </ul>
    </div>

</div>
