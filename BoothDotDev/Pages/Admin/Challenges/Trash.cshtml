@page "/admin/challenges/trash"
@using System.Diagnostics
@using BoothDotDev.Data
@using Humanizer
@model Trash

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <p class="crumb"><a asp-page="/Admin/Challenges/Index">Challenges</a> / Trash</p>

    <div class="admin-header">
        <div>
            <h1>Trash</h1>
            <p>Trashed challenges are hidden from the public site until restored</p>
        </div>
        <a asp-page="/Admin/Challenges/Index" class="btn btn-primary"><i class="ti ti-arrow-left" style="font-size:15px"></i>Back to
            challenges</a>
    </div>

    @if (Model.Challenges.Count == 0)
    {
        <p class="table-empty-state">Trash is empty</p>
    }
    else
    {
        <div data-search-scope data-bulk-select-scope>
            <div class="table-toolbar">
                <div class="search-input">
                    <i class="ti ti-search"></i>
                    <input type="text" id="search" placeholder="Search trash&hellip;">
                </div>
                <label class="select-all-label">
                    <input type="checkbox" data-select-all aria-label="Select all">
                    select all
                </label>
            </div>

            <div class="bulk-actions" data-bulk-actions hidden>
                <span><span data-selected-count>0</span> selected</span>
                <button type="submit" form="bulk-delete-form" class="btn icon-btn danger" aria-label="Delete permanently">
                    <i class="ti ti-trash-x"></i> Delete permanently
                </button>
            </div>
            <form id="bulk-delete-form" method="post" asp-page-handler="PermanentlyDeleteBulk"
                  data-confirm="Permanently delete {count} challenge(s)? This cannot be undone."></form>

            <ul class="admin-row-list">
                @foreach (var challenge in Model.Challenges)
                {
                    var badgeClass = challenge.Visibility switch
                    {
                        Visibility.Published => "published",
                        Visibility.Private => "private",
                        _ => "unlisted"
                    };

                    <li class="admin-row" data-search-item>
                        <input type="checkbox" name="ids" value="@challenge.Id" form="bulk-delete-form" data-row-select
                               aria-label="Select @challenge.Title">
                        <span class="badge badge-@badgeClass">
                        @switch (challenge.Visibility)
                            {
                                case Visibility.Published:
                                    <text><span class="dot"></span> Published</text>
                                    break;

                                case Visibility.Private:
                                    <text><i class="ti ti-lock"></i> Private</text>
                                    break;

                                case Visibility.Unlisted:
                                    <text><i class="ti ti-eye-off"></i> Unlisted</text>
                                    break;

                                default:
                                    throw new UnreachableException();
                            }
                        </span>
                        <div class="row-body">
                            <div class="row-title" data-search>@challenge.Title</div>
                        </div>
                        <span class="row-meta">
                            <abbr
                                title="@challenge.TrashedAt!.Value.ToString("yyyy-MM-dd HH:mm:ss")">@challenge.TrashedAt!.Value.Humanize()</abbr>
                        </span>
                        <div class="row-actions">
                            <a asp-page="/Admin/Challenges/Edit" asp-route-id="@challenge.Id" class="icon-btn">edit</a>
                            <form method="post" asp-page-handler="Restore" asp-route-id="@challenge.Id">
                                <button type="submit" class="icon-btn">restore</button>
                            </form>
                            <form method="post" asp-page-handler="PermanentlyDelete" asp-route-id="@challenge.Id"
                                  data-confirm="Permanently delete '@challenge.Title'? This cannot be undone.">
                                <button type="submit" class="icon-btn danger">delete</button>
                            </form>
                        </div>
                    </li>
                }
                <li class="list-empty-state" data-search-empty hidden>No challenges found</li>
            </ul>
        </div>
    }

</div>
