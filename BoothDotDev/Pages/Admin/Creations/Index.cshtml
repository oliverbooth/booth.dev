@page "/admin/creations"
@using BoothDotDev.Data
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Creations</h1>
            <p>Create, edit, and delete creations</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Creations/Trash" class="btn icon-btn"><i class="ti ti-trash" style="font-size:15px"></i>Trash</a>
            <a asp-page="/Admin/Creations/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New creation</a>
        </div>
    </div>

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search creations&hellip;">
            </div>
        </div>

        <ul class="admin-row-list">
            @foreach (var creation in Model.Creations)
            {
                var kindLabel = creation.Kind switch
                {
                    CreationKind.Drawing => "Drawing",
                    CreationKind.ThreeD => "3D",
                    _ => "Music"
                };

                <li class="admin-row" data-search-item>
                    <partial name="Partials/_VisibilityBadge" model="creation.Visibility" />
                    <div class="row-body">
                        <div class="row-title" data-search>@creation.Title</div>
                        <div class="row-sub" data-search>@kindLabel</div>
                    </div>
                    <span class="row-meta"><abbr
                            title="@creation.PublishedAt.ToString("yyyy-MM-dd HH:mm:ss")">@creation.PublishedAt.Humanize()</abbr></span>
                    <div class="row-actions">
                        <a asp-page="/Admin/Creations/Edit" asp-route-id="@creation.Id" class="icon-btn">edit</a>
                        <a asp-page="/Portfolio/Item" asp-route-slug="@creation.Slug" target="_blank" class="icon-btn">view</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@creation.Id">
                            <button type="submit" class="icon-btn danger">delete</button>
                        </form>
                    </div>
                </li>
            }
            <li class="list-empty-state" data-search-empty hidden>No creations found</li>
        </ul>
    </div>

</div>
