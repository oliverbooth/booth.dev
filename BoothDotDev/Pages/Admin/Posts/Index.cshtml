@page "/admin/posts"
@using System.Diagnostics
@using BoothDotDev.Data
@using BoothDotDev.Services
@using Humanizer
@model BoothDotDev.Pages.Admin.Posts.Index
@inject BlogPostService BlogPostService

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Posts</h1>
            <p>Create, edit, and delete blog posts</p>
        </div>
        <a asp-page="/Admin/Posts/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New post</a>
    </div>

    <div class="table-toolbar">
        <div class="search-input">
            <i class="ti ti-search"></i>
            <input type="text" placeholder="Search posts&hellip;">
        </div>
        @*<div class="filter-row" style="margin:0">
            <span class="pill active">All</span>
            <span class="pill">Published</span>
            <span class="pill">Drafts</span>
        </div>*@
    </div>

    <table class="data-table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Visibility</th>
            <th>Updated</th>
            <th style="text-align:right">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var post in Model.BlogPosts)
        {
            var timestamp = post.Updated ?? post.Published;
            var badgeClass = post.Visibility switch
            {
                Visibility.Published => "published",
                Visibility.Private => "private",
                _ => "unlisted"
            };
            
            <tr>
                <td>
                    <div class="row-title">@post.Title</div>
                    <div class="row-sub">/blog/@post.Slug</div>
                </td>
                <td>@BlogPostService.GetCategory(post.CategoryId)?.Name</td>
                <td><span class="badge badge-@badgeClass">
                    @switch (post.Visibility)
                    {
                        case Visibility.Published:
                            <text><span class="dot"></span> Published</text>
                            break;

                        case Visibility.Private:
                            <text><i class="ti ti-lock"></i> Private</text>
                            break;

                        case Visibility.Unlisted:
                            <text><i class="ti ti-eye-off"></i> Unlisted</text>
                            break;

                        default:
                            throw new UnreachableException();
                    }
                </span></td>
                <td><abbr title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.Humanize()</abbr></td>
                <td>
                    <div class="row-actions">
                        <a asp-page="/Admin/Posts/Edit" asp-route-id="@post.Id" class="icon-btn" aria-label="Edit"><i class="ti ti-edit"></i></a>
                        <a asp-page="/Blog/Article" asp-route-slug="@post.Slug" class="icon-btn" aria-label="View"><i class="ti ti-eye"></i></a>
                        <button class="icon-btn danger" aria-label="Delete"><i class="ti ti-trash"></i></button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

</div>
