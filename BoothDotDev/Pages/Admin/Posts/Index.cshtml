@page "/admin/posts"
@using System.Diagnostics
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@model Index
@inject BlogPostService BlogPostService

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Posts</h1>
            <p>Create, edit, and delete blog posts</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Posts/Categories/Index" class="btn icon-btn"><i class="ti ti-folder"
                                                                                style="font-size:15px"></i>Categories</a>
            <a asp-page="/Admin/Posts/Trash" class="btn icon-btn"><i class="ti ti-trash" style="font-size:15px"></i>Trash</a>
            <a asp-page="/Admin/Posts/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New post</a>
        </div>
    </div>

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search posts&hellip;">
            </div>
        </div>

        <ul class="admin-row-list">
            @foreach (var post in Model.BlogPosts)
            {
                var timestamp = post.UpdatedAt ?? post.PublishedAt;
                var badgeClass = post.Visibility switch
                {
                    Visibility.Published => "published",
                    Visibility.Private => "private",
                    _ => "unlisted"
                };
                var categoryEntity = BlogPostService.GetCategory(post.CategoryId);
                var category = categoryEntity?.Name;
                var hue = post.Color ?? categoryEntity?.EffectiveColor;

                <li class="admin-row" data-search-item>
                    <span class="badge badge-@badgeClass">
                    @switch (post.Visibility)
                        {
                            case Visibility.Published:
                                <text><span class="dot"></span> Published</text>
                                break;

                            case Visibility.Private:
                                <text><i class="ti ti-lock"></i> Private</text>
                                break;

                            case Visibility.Unlisted:
                                <text><i class="ti ti-eye-off"></i> Unlisted</text>
                                break;

                            default:
                                throw new UnreachableException();
                        }
                    </span>
                    <div class="row-body">
                        <div class="row-title" data-search>
                            @if (hue is { } postHue)
                            {
                                <span class="hue-dot" data-hue="@postHue.ToDataHue()"
                                      title="@postHue.ToDataHue() (@(post.Color is null ? "from category" : "set on post"))"></span>
                            }
                            @post.Title
                        </div>
                        <div class="row-sub" data-search>
                            <abbr
                                title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.ToString("MMM yyyy")</abbr>@(category is null ? "" : $" · {category}")
                        </div>
                    </div>
                    <div class="row-actions">
                        <a asp-page="/Admin/Posts/Edit" asp-route-id="@post.Id" class="icon-btn">edit</a>
                        <a asp-page="/Blog/Article" asp-route-slug="@post.Slug" class="icon-btn">view</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@post.Id">
                            <button type="submit" class="icon-btn danger">delete</button>
                        </form>
                    </div>
                </li>
            }
            <li class="list-empty-state" data-search-empty hidden>No posts found</li>
        </ul>
    </div>

</div>
