@page "/admin/tutorials"
@using System.Diagnostics
@using BoothDotDev.Data
@using Humanizer
@model Index

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Tutorials</h1>
            <p>Create, edit, and delete tutorial articles</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Tutorials/Folders/Index" class="btn icon-btn"><i class="ti ti-folder" style="font-size:15px"></i>Folders</a>
            <a asp-page="/Admin/Tutorials/Trash" class="btn icon-btn"><i class="ti ti-trash" style="font-size:15px"></i>Trash</a>
            <a asp-page="/Admin/Tutorials/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New article</a>
        </div>
    </div>

    <div data-search-scope>
        <div class="table-toolbar">
            <div class="search-input">
                <i class="ti ti-search"></i>
                <input type="text" id="search" placeholder="Search articles&hellip;">
            </div>
        </div>

        @if (Model.FolderGroups.Count == 0)
        {
            <p class="list-empty-state">No articles yet</p>
        }
        else
        {
            <div class="row-groups">
                @foreach (var group in Model.FolderGroups)
                {
                    <div class="row-group">
                        <div class="row-group-header">
                            <i class="ti ti-folder"></i>
                            <span class="row-group-title">@(group.Folder?.Title ?? "unfiled")</span>
                            <span class="row-group-count">@("part".ToQuantity(group.Articles.Count))</span>
                        </div>
                        <ul class="admin-row-list admin-row-list--nested">
                            @for (var i = 0; i < group.Articles.Count; i++)
                            {
                                var article = group.Articles[i];
                                var timestamp = article.UpdatedAt ?? article.PublishedAt;
                                var badgeClass = article.Visibility switch
                                {
                                    Visibility.Published => "published",
                                    Visibility.Private => "private",
                                    _ => "unlisted"
                                };
                                var path = Model.GetPath(article);

                                <li class="admin-row" data-search-item>
                                    <span class="row-meta">pt @(i + 1)</span>
                                    <div class="row-body">
                                        <div class="row-title" data-search>@article.Title</div>
                                    </div>
                                    <span class="badge badge-@badgeClass">
                                    @switch (article.Visibility)
                                        {
                                            case Visibility.Published:
                                                <text><span class="dot"></span> Published</text>
                                                break;

                                            case Visibility.Private:
                                                <text><i class="ti ti-lock"></i> Private</text>
                                                break;

                                            case Visibility.Unlisted:
                                                <text><i class="ti ti-eye-off"></i> Unlisted</text>
                                                break;

                                            default:
                                                throw new UnreachableException();
                                        }
                                    </span>
                                    <span class="row-meta"><abbr
                                            title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.Humanize()</abbr></span>
                                    <div class="row-actions">
                                        <a asp-page="/Admin/Tutorials/Edit" asp-route-id="@article.Id" class="icon-btn">edit</a>
                                        <a asp-page="/Learn/Tutorials/Index" asp-route-slug="@path" class="icon-btn">view</a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@article.Id">
                                            <button type="submit" class="icon-btn danger">delete</button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        <p class="list-empty-state" data-search-empty hidden>No articles found</p>
    </div>

</div>
