@page "/admin/streaks"
@using BoothDotDev.Data
@using Humanizer
@using BoothDotDev.Services
@model Index
@inject StreakService StreakService

@{
    Layout = "_AdminLayout";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Streaks</h1>
            <p>Reorder, edit, and delete streaks on the streaks page</p>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-page="/Admin/Streaks/Trash" class="btn icon-btn"><i class="ti ti-trash" style="font-size:15px"></i>Trash</a>
            <a asp-page="/Admin/Streaks/Edit" class="btn btn-primary"><i class="ti ti-plus" style="font-size:15px"></i>New streak</a>
        </div>
    </div>

    <form method="post" asp-page-handler="Reorder" id="reorder-form"></form>

    @if (Model.Streaks.Count == 0)
    {
        <p class="table-empty-state">No streaks yet</p>
    }
    else
    {
        <ul class="reorder-list" data-reorder-list data-reorder-form="reorder-form">
            @foreach (var streak in Model.Streaks)
            {
                var timestamp = streak.UpdatedAt ?? streak.PublishedAt;
                var stats = StreakService.GetStats(streak);
                var modeLabel = streak.Mode == StreakMode.CheckIn ? "check-in" : "check-out";

                <li class="reorder-item" data-reorder-item data-id="@streak.Id" draggable="true">
                    <i class="ti ti-grip-vertical reorder-handle" aria-hidden="true"></i>
                    <div class="reorder-move">
                        <button type="button" class="reorder-move-btn" data-move="up" aria-label="Move '@streak.Title' up"><i
                                class="ti ti-chevron-up"></i></button>
                        <button type="button" class="reorder-move-btn" data-move="down" aria-label="Move '@streak.Title' down"><i
                                class="ti ti-chevron-down"></i></button>
                    </div>
                    <partial name="Partials/_VisibilityBadge" model="streak.Visibility" />
                    <div class="row-body">
                        <div class="row-title">@streak.Title</div>
                        <div class="row-sub">@modeLabel &middot; @stats.Current current &middot; @stats.Best best</div>
                    </div>
                    <span class="row-meta"><abbr title="@timestamp.ToString("yyyy-MM-dd HH:mm:ss")">@timestamp.Humanize()</abbr></span>
                    <div class="row-actions" draggable="false">
                        <a asp-page="/Admin/Streaks/Edit" asp-route-id="@streak.Id" class="icon-btn">edit</a>
                        <a asp-page="/Streaks" asp-fragment="@streak.Slug" class="icon-btn">view</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@streak.Id">
                            <button type="submit" class="icon-btn danger">delete</button>
                        </form>
                    </div>
                </li>
            }
        </ul>

        <div class="table-toolbar" data-reorder-save hidden>
            <p class="hint">Order changed - it isn't saved yet.</p>
            <button type="submit" form="reorder-form" class="btn btn-primary"><i class="ti ti-device-floppy"></i>Save order</button>
        </div>
    }

</div>
