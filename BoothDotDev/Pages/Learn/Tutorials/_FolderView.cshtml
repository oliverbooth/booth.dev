@using BoothDotDev.Data
@using BoothDotDev.Data.Models
@using BoothDotDev.Extensions
@using BoothDotDev.Services
@using Humanizer
@using Markdig
@model BoothDotDev.Data.Models.TutorialFolder?
@inject MarkdownPipeline MarkdownPipeline
@inject TutorialService TutorialService

@{
    var parents = new Stack<TutorialFolder>();
    var parent = Model?.Parent;
    while (parent is not null)
    {
        var folderResult = TutorialService.GetFolder(parent.Value);
        if (folderResult.IsFailed)
        {
            throw new InvalidOperationException($"Folder chain references missing parent {parent.Value}.");
        }

        parents.Push(folderResult.Value);
        parent = folderResult.Value.Parent;
    }

    var folders = TutorialService.GetFolders(Model, Visibility.Published);
    var articles = Model is not null
        ? TutorialService.GetArticles(Model, Visibility.Published)
        : [];
}

<div class="page-grid">

    <div class="page-header-row">
        <p class="crumb">
            <a asp-page="/Index">Home</a> /
            <a asp-page="/Learn/Tutorials/Index" asp-route-slug="">Tutorials</a>
            @while (parents.Count > 0)
            {
                var current = parents.Pop();
                <text>
                    / <a asp-page="/Learn/Tutorials/Index" asp-route-slug="@TutorialService.GetFullSlug(current)">@current.Title</a></text>
            }
            @if (Model is not null)
            {
                <text> / @Model.Title</text>
            }
        </p>
        <div class="page-actions">
            @{ var feedPath = Model is null ? "/learn" : $"/learn/{TutorialService.GetFullSlug(Model)}"; }
            <a href="@(feedPath).rss" class="icon-link" aria-label="Subscribe to this listing's RSS feed" title="RSS feed"><i
                    class="ti ti-rss"></i></a>
            @if (Model is not null && User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Admin/Tutorials/Folders/Edit" asp-route-id="@Model.Id" class="btn"><i class="ti ti-edit"></i> Edit</a>
            }
        </div>
    </div>

    @if (Model?.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="private">
            <p class="callout-title"><i class="ti ti-lock"></i> This folder is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }
    else if (Model?.Visibility == Visibility.Unlisted)
    {
        <div class="callout" data-callout="unlisted">
            <p class="callout-title"><i class="ti ti-eye-off"></i> This folder is unlisted</p>
            <div class="callout-body">
                <p>It doesn't appear in listings or search, but anyone with this link can view it.</p>
            </div>
        </div>
    }

    <h1 data-hue="@(Model?.EffectiveColor.ToDataHue() ?? "brand")">@(Model?.Title ?? "Learn")</h1>

    @if (Model is not null && (!string.IsNullOrEmpty(Model.Description) || folders.Count > 0 || articles.Count > 0))
    {
        var counts = string.Join(", ", new[]
        {
            folders.Count > 0 ? "subfolder".ToQuantity(folders.Count) : null,
            articles.Count > 0 ? "article".ToQuantity(articles.Count) : null
        }.OfType<string>());

        <p class="lede">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Html.Raw(Markdown.ToHtmlUnwrapped(Model.Description, MarkdownPipeline))
            }
            @if (counts.Length > 0)
            {
                <text> @(counts).</text>
            }
        </p>
    }

    @if (Model is null || folders.Count > 0 || articles.Count > 0)
    {
        <div class="learn-grid">
            @if (Model is null)
            {
                <a asp-page="/Learn/Challenges/Index" class="folder-card" data-hue="pink">
                    <i class="ti ti-code folder-card-glyph" aria-hidden="true"></i>
                    <h3>Dev Challenges</h3>
                    <p class="folder-card-count">Codewars-style problems to test your skills.</p>
                </a>
            }

            @foreach (var folder in folders)
            {
                var articleCount = TutorialService.GetArticles(folder, Visibility.Published).Count;

                <a asp-page="/Learn/Tutorials/Index" asp-route-slug="@TutorialService.GetFullSlug(folder)" class="folder-card"
                   data-hue="@folder.EffectiveColor.ToDataHue()">
                    <span class="folder-icon" aria-hidden="true"></span>
                    <h3>@folder.Title</h3>
                    <p class="folder-card-count">@("tutorial".ToQuantity(articleCount))</p>
                </a>
            }

            @for (var index = 0; index < articles.Count; index++)
            {
                var article = articles[index];

                <a asp-page="/Learn/Tutorials/Index" asp-route-slug="@TutorialService.GetFullSlug(article)" class="article-card"
                   data-hue="@((article.Color ?? Model!.EffectiveColor).ToDataHue())">
                    <span class="doc-icon" aria-hidden="true"></span>
                    @if (article.HasOtherParts)
                    {
                        <span class="article-card-part">part @(index + 1)</span>
                    }
                    <h3>@article.Title</h3>
                    <p class="article-card-time">@article.GetEstimatedReadingTime() min read</p>
                </a>
            }
        </div>
    }

    @if (Model is not null && folders.Count == 0 && articles.Count == 0)
    {
        <p class="footnote">Nothing here yet.</p>
    }

</div>
