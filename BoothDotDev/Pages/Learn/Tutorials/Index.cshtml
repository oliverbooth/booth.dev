@page "/learn/{**slug}"
@using BoothDotDev.Data
@model Index

@{
    // ViewData set from within a <partial> never reaches this page's own layout - it gets a snapshotted copy
    // of ViewData, not a live reference back to this one. Set it here instead; see _ArticleView.cshtml/
    // _FolderView.cshtml, which used to (incorrectly) set this themselves.
    if (Model.CurrentArticle is { } article)
    {
        ViewData["Post"] = article;
        ViewData["Title"] = article.Title;
    }
    else
    {
        ViewData["Title"] = "Tutorials";
        if (Model.CurrentFolder is null)
        {
            ViewData["Post"] = new IndexPageCard("LEARN", "Learn",
                "Tutorials and hands-on coding challenges to help you learn by building.", PaletteHue.Brand, "learn");
        }
    }

    ViewData["Page"] = "Learn";
}

@if (Model.ShowFolderView)
{
    <partial name="_FolderView" model="Model.CurrentFolder" />
}
else if (Model.CurrentArticle is not null)
{
    <partial name="_ArticleView" model="Model.CurrentArticle" />
}
