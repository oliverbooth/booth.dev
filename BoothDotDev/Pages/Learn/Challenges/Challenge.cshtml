@page "/challenge/{id}"
@inject MarkdownRenderingService MarkdownRenderingService
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Pages.Shared.Partials
@using BoothDotDev.Services
@model Challenge
@{
    ViewData["Title"] = Model.DevChallenge.Title;
    ViewData["Page"] = "Challenges";
    ViewData["Post"] = Model.DevChallenge;
    var challenge = Model.DevChallenge;
    var hasSolution = challenge.ShowSolution && !string.IsNullOrWhiteSpace(challenge.Solution);
}

<div class="page">

    <p class="crumb">
        <a asp-page="/Index">Home</a> /
        <a asp-page="/Learn/Challenges/Index">Challenges</a> /
        @challenge.Title
    </p>

    @if (challenge.Visibility == Visibility.Private)
    {
        <div class="callout" data-callout="warning">
            <p class="callout-title"><i class="ti ti-lock"></i> This challenge is private</p>
            <div class="callout-body">
                <p>It isn't publicly accessible and can only be viewed while signed in as the site owner.</p>
            </div>
        </div>
    }

    @{
        var header = new ContentHeader
        {
            Title = challenge.Title,
            Badge = "challenge",
            BadgeClass = "badge-magenta",
            Meta = [$"published {challenge.PublishedAt.ToShortString()}", hasSolution ? "solution available" : "solution locked"],
            SourceUrl = $"/challenge/{challenge.Id}.md",
            EditUrl = User.Identity?.IsAuthenticated == true ? Url.Page("/Admin/Challenges/Edit", new { id = challenge.Id }) : null
        };
    }

    <partial name="Partials/_ContentHeader" model="header" />

    <div class="prose">
        @Html.Raw(MarkdownRenderingService.Render(challenge.Description, challenge.Id, challenge.PublishedAt, "challenge"))
    </div>

    @if (hasSolution)
    {
        <div class="prose challenge-solution">
            <details class="callout" data-callout="success">
                <summary class="callout-title"><i class="ti ti-bulb"></i> Solution</summary>
                <div class="callout-body">
                    @Html.Raw(MarkdownRenderingService.Render(challenge.Solution!, challenge.Id, challenge.PublishedAt, "challenge"))
                </div>
            </details>
        </div>
    }
    else
    {
        <div class="challenge-locked">
            <span class="challenge-locked-icon"><i class="ti ti-lock" aria-hidden="true"></i></span>
            <p class="challenge-locked-title">Solution not released yet</p>
            <p class="challenge-locked-desc">Give it a real attempt first. Check back later for the official solution.</p>
        </div>
    }

</div>
