@page "/challenges"
@using BoothDotDev.Data
@using BoothDotDev.Extensions
@using BoothDotDev.Pages.Shared.Partials
@using BoothDotDev.Services
@using Humanizer
@model Index
@inject DevChallengeService DevChallengeService
@inject MarkdownRenderingService MarkdownRenderingService
@{
    ViewData["Title"] = "Dev Challenges";
    ViewData["Page"] = "Challenges";
}

<div class="page-grid">

    <span class="eyebrow">
        <a asp-page="/Learn/Tutorials/Index" asp-route-slug=""><i class="ti ti-arrow-narrow-left"></i> back to learn</a>
    </span>

    <h1>Dev Challenges</h1>
    <partial name="Partials/_AdminLinks" model="@(new AdminLink[] { new("manage challenges", "/Admin/Challenges/Index") })" />
    <p class="lede">
        These are a collection of challenges I've written to help you improve your skills as a developer.
        They're designed to be fun, challenging, and educational. I hope you enjoy them!
    </p>

    <div class="sticky-grid">
        @{
            var number = 1;
        }
        @foreach (var challenge in DevChallengeService.GetDevChallenges(Visibility.Published))
        {
            var hasSolution = challenge.ShowSolution && !string.IsNullOrWhiteSpace(challenge.Solution);
            var solutionState = hasSolution ? "Solution unlocked" : "Solution locked";
            var excerpt = MarkdownRenderingService.RenderPlainTextExcerpt(challenge, out _);

            <a asp-page="/Learn/Challenges/Challenge" asp-route-id="@challenge.Id" class="challenge-card"
               data-hue="@challenge.Hue.ToDataHue()">
                <div class="challenge-card-top">
                    <div class="challenge-card-pills">
                        <span class="challenge-card-pill">#@number</span>
                        @if (challenge.Difficulty is { } difficulty)
                        {
                            <span class="challenge-card-pill challenge-card-pill--rating">@difficulty.ToString().ToLowerInvariant()</span>
                        }
                    </div>
                    <i class="ti @(hasSolution ? "ti-lock-open" : "ti-lock") challenge-card-lock@(hasSolution ? " challenge-card-lock--open" : "")"
                       role="img" aria-label="@solutionState" title="@solutionState"></i>
                </div>
                <h3>@challenge.Title</h3>
                @if (!string.IsNullOrWhiteSpace(excerpt))
                {
                    <p class="challenge-card-desc">@excerpt</p>
                }
                <p class="challenge-card-published">published @challenge.PublishedAt.Humanize()</p>
            </a>
            number++;
        }
    </div>

</div>
